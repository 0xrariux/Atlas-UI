import { AtlasWorkspaceTab, AtlasWorkspaceTabList } from "@atlas-ui/stable.slint";
import { AtlasGrid } from "@atlas-ui-tokens/tokens.slint";

// A live Slint layout fixture. Rust observes geometry after each render pass;
// the values below come from the actual child items and repeated list layout.
export component LayoutRuntimeFixture inherits Window {
    in-out property <[DocumentListItem]> items;
    out property <bool> stacked: switcher.stacked;
    out property <int> grid-columns: nested-grid.column-count;
    out property <float> first-x: first.x / 1px;
    out property <float> first-y: first.y / 1px;
    out property <float> first-width: first.width / 1px;
    out property <float> first-height: first.height / 1px;
    out property <float> second-x: second.x / 1px;
    out property <float> second-y: second.y / 1px;
    out property <float> second-width: second.width / 1px;
    out property <float> second-height: second.height / 1px;
    out property <float> list-height: document-list.min-height / 1px;

    preferred-width: 1000px;
    preferred-height: 760px;
    background: #ffffff;

    switcher := AtlasSwitcher {
        x: 20px;
        y: 20px;
        width: parent.width - 40px;
        height: 240px;
        reference-width: self.width;
        switch-below: 600px;
        gap: LayoutGap.compact;

        first := Rectangle {
            min-width: 180px;
            preferred-width: 320px;
            max-width: 620px;
            min-height: 100px;
            preferred-height: 100px;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #dceaf6;
        }
        second := Rectangle {
            min-width: 180px;
            preferred-width: 320px;
            max-width: 620px;
            min-height: 100px;
            preferred-height: 100px;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #f6eadc;

            nested-grid := AtlasAutoGrid {
                width: parent.width;
                height: parent.height;
                reference-width: switcher.stacked ? switcher.width
                    : (switcher.width - 2 * AtlasGrid.space-2) / 2;
                basis-width: switcher.stacked ? switcher.width
                    : (switcher.width - 2 * AtlasGrid.space-2) / 2;
                gap: LayoutGap.compact;
                Rectangle {
                    min-width: 80px;
                    preferred-width: nested-grid.item-basis;
                    preferred-height: 40px;
                    background: #b9d8bd;
                }
                Rectangle {
                    min-width: 80px;
                    preferred-width: nested-grid.item-basis;
                    preferred-height: 40px;
                    background: #b9d8bd;
                }
            }
        }
    }

    document-list := AtlasDocumentList {
        x: 20px;
        y: 290px;
        width: min(parent.width - 40px, 320px);
        height: self.min-height;
        items: root.items;
    }
}

// Dispatch real window events to these controls from the Rust fixture.
export component InteractionRuntimeFixture inherits Window {
    in-out property <bool> modal-open: false;
    in-out property <bool> menu-open: false;
    in-out property <bool> drawer-open: false;
    in-out property <bool> first-enabled: true;
    out property <bool> first-focused: first.focused;
    out property <bool> first-focus-visible: first.focus-visible;
    out property <bool> first-pressed: first.pressed;
    out property <bool> second-focused: second.focused;
    out property <int> first-activations: first-count;
    out property <int> second-activations: second-count;
    out property <int> modal-confirms: confirm-count;
    out property <int> modal-cancels: cancel-count;
    out property <int> focus-restores: restore-count;
    out property <int> menu-active-index: menu.active-index;
    out property <string> menu-selected-id: selected-id;
    out property <int> menu-dismissals: menu-dismiss-count;
    out property <int> menu-traversals: menu-traverse-count;
    out property <bool> menu-traversed-backward: menu-traverse-backward;
    out property <int> drawer-closes: drawer-close-count;
    private property <int> first-count: 0;
    private property <int> second-count: 0;
    private property <int> confirm-count: 0;
    private property <int> cancel-count: 0;
    private property <int> restore-count: 0;
    private property <string> selected-id: "";
    private property <int> menu-dismiss-count: 0;
    private property <int> menu-traverse-count: 0;
    private property <bool> menu-traverse-backward: false;
    private property <int> drawer-close-count: 0;

    preferred-width: 400px;
    preferred-height: 300px;

    first := ActionArea {
        x: 20px; y: 20px; width: 120px; height: 40px;
        enabled: root.first-enabled;
        activated => { root.first-count += 1; }
    }
    second := ActionArea {
        x: 20px; y: 80px; width: 120px; height: 40px;
        activated => { root.second-count += 1; }
    }
    modal := AtlasModal {
        width: parent.width; height: parent.height;
        open <=> root.modal-open;
        title: "Confirm";
        description: "Keyboard focus test";
        confirmed => { root.confirm-count += 1; root.modal-open = false; }
        cancelled => { root.cancel-count += 1; root.modal-open = false; }
        focus-restore-requested => { root.restore-count += 1; first.focus-from-keyboard(); }
    }
    menu := AtlasMenu {
        x: 160px; y: 20px;
        open: root.menu-open;
        items: [
            { id: "first", label: "First", shortcut: "", enabled: true, danger: false },
            { id: "disabled", label: "Disabled", shortcut: "", enabled: false, danger: false },
            { id: "last", label: "Last", shortcut: "", enabled: true, danger: false }
        ];
        item-requested(id) => { root.selected-id = id; root.menu-open = false; }
        dismissed => { root.menu-dismiss-count += 1; root.menu-open = false; }
        traversal-requested(backwards) => {
            root.menu-traverse-count += 1;
            root.menu-traverse-backward = backwards;
            if (backwards) { first.focus-from-keyboard(); }
            else { second.focus-from-keyboard(); }
        }
        focus-restore-requested => { root.restore-count += 1; first.focus-from-keyboard(); }
    }
    drawer := AtlasDrawer {
        width: parent.width; height: parent.height;
        open <=> root.drawer-open;
        title: "Details";
        body-text: "Drawer keyboard focus test";
        close => { root.drawer-close-count += 1; root.drawer-open = false; }
        focus-restore-requested => { root.restore-count += 1; first.focus-from-keyboard(); }
    }
    public function focus-first() { first.focus-from-keyboard(); }
    public function focus-second() { second.focus-from-keyboard(); }
}

// The host intentionally owns selection, close acceptance, and model changes.
export component TabsRuntimeFixture inherits Window {
    in-out property <int> tab-count: 3;
    in-out property <bool> second-enabled: true;
    out property <int> active-index: tabs.active-index;
    out property <int> focused-index: last-focus-index;
    out property <int> focus-requests: focus-count;
    out property <int> activated-index: last-activated-index;
    out property <int> closed-index: last-closed-index;
    private property <int> last-focus-index: -1;
    private property <int> focus-count: 0;
    private property <int> last-activated-index: -1;
    private property <int> last-closed-index: -1;

    preferred-width: 520px;
    preferred-height: 160px;

    tabs := AtlasWorkspaceTabList {
        x: 20px; y: 20px; width: parent.width - 40px;
        tab-count: root.tab-count;
        selected-index: 0;
        focus-requested(index) => {
            root.last-focus-index = index;
            root.focus-count += 1;
            if (index == 0) { first.focus-from-group(); }
            else if (index == 1) { second.focus-from-group(); }
            else if (index == 2) { third.focus-from-group(); }
        }
        activated(index) => { root.last-activated-index = index; }
        close-requested(index) => {
            root.last-closed-index = index;
            if (index == 2) {
                root.tab-count = 2;
                tabs.settle-after-close(2, 2, -1);
            }
        }

        first := AtlasWorkspaceTab {
            width: 140px; tab-id: "first"; text: "First";
            index: 0; count: root.tab-count; closable: true;
            active-in-roving-group: tabs.active-index == 0;
            activated => { tabs.request-activation(0); }
            close-requested => { tabs.request-close(0); }
            navigation-requested(direction) => { tabs.navigate(direction); }
        }
        second := AtlasWorkspaceTab {
            width: 140px; tab-id: "second"; text: "Second";
            index: 1; count: root.tab-count; closable: true;
            enabled: root.second-enabled;
            active-in-roving-group: tabs.active-index == 1;
            activated => { tabs.request-activation(1); }
            close-requested => { tabs.request-close(1); }
            navigation-requested(direction) => { tabs.navigate(direction); }
        }
        third := AtlasWorkspaceTab {
            width: 140px; tab-id: "third"; text: "Third";
            index: 2; count: root.tab-count; closable: true;
            visible: root.tab-count == 3;
            active-in-roving-group: tabs.active-index == 2;
            activated => { tabs.request-activation(2); }
            close-requested => { tabs.request-close(2); }
            navigation-requested(direction) => { tabs.navigate(direction); }
        }
    }
    public function focus-index(index: int) { tabs.focus-index(index); }
}

// Two controlled overlays share one window and restore focus in stack order.
export component NestedOverlayRuntimeFixture inherits Window {
    in-out property <bool> modal-open: false;
    in-out property <bool> menu-open: false;
    in-out property <bool> anchor-eligible: true;
    out property <bool> outside-focused: outside.focused;
    out property <bool> inside-focused: inside.focused;
    out property <int> menu-dismissals: menu-dismiss-count;
    out property <int> modal-dismissals: modal-dismiss-count;
    out property <int> inside-activations: inside-count;
    private property <int> menu-dismiss-count: 0;
    private property <int> modal-dismiss-count: 0;
    private property <int> inside-count: 0;

    preferred-width: 480px;
    preferred-height: 320px;

    outside := ActionArea {
        x: 20px; y: 20px; width: 100px; height: 40px;
    }
    modal := AtlasModalFrame {
        width: parent.width; height: parent.height;
        open <=> root.modal-open;
        focus-on-open: !root.menu-open;
        label: "Nested dialog";
        description: "Focus returns through nested overlays";
        dismissed => { root.modal-dismiss-count += 1; root.modal-open = false; }
        focus-restore-requested => { outside.focus-from-keyboard(); }
        inside := ActionArea {
            width: 120px; height: 40px;
            contained-focus: true;
            activated => { root.inside-count += 1; }
            dismiss-requested => { root.modal-dismiss-count += 1; root.modal-open = false; }
        }
    }
    menu := AtlasMenu {
        x: 220px; y: 60px;
        open: root.menu-open;
        anchor-eligible: root.anchor-eligible;
        items: [{ id: "one", label: "One", shortcut: "", enabled: true, danger: false }];
        dismissed => { root.menu-dismiss-count += 1; root.menu-open = false; }
        focus-restore-requested => { inside.focus-from-keyboard(); }
    }
    public function focus-outside() { outside.focus-from-keyboard(); }
    public function focus-inside() { inside.focus-from-keyboard(); }
}

export component PopoverRuntimeFixture inherits Window {
    in-out property <bool> popover-open: false;
    in-out property <bool> anchor-eligible: true;
