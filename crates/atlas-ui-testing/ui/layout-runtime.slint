    preferred-width: 320px;
    preferred-height: 120px;
    range := AtlasRangeControl {
        x: 20px; y: 20px; width: 240px;
        label: "Zoom";
        value: 50;
        value-changed(value) => { root.changes += 1; }
    }
}

export component TreeViewRuntimeFixture inherits Window {
    in property <[TreeViewRow]> rows;
    out property <int> focused-index: tree.focused-index;
    out property <string> selected-id: chosen;
