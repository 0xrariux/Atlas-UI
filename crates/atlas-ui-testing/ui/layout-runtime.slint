        x: 20px; y: 20px; width: 240px; height: 160px;
        rows: root.rows;
        selection-requested(id) => { root.chosen = id; }
        expansion-requested(id, expanded) => {
            root.toggled = id;
            root.target-expanded = expanded;
        }
    }
    public function focus-first() { tree.focus-index(0); tree.focus-from-keyboard(); }
}

export component ScrollViewportRuntimeFixture inherits Window {
    in property <length> host-content-width: 400px;
    in property <length> host-content-height: 300px;
    in property <bool> right-to-left: false;
    out property <length> offset-x: viewport.viewport-x;
    out property <length> offset-y: viewport.viewport-y;
    out property <length> maximum-x: viewport.maximum-x;
    out property <length> maximum-y: viewport.maximum-y;

    preferred-width: 320px;
    preferred-height: 240px;
    viewport := AtlasScrollViewport {
        x: 20px; y: 20px; width: 200px; height: 120px;
        horizontal-scroll-enabled: true;
        vertical-scroll-enabled: true;
        logical-direction: root.right-to-left ? LogicalDirection.right-to-left : LogicalDirection.left-to-right;
        content-width: root.host-content-width;
        content-height: root.host-content-height;
        Rectangle { width: root.host-content-width; height: root.host-content-height; background: #e0e0e0; }
    }
    public function scroll(x: length, y: length) {
        viewport.scroll-to-x(x);
        viewport.scroll-to(y);
    }
    public function reveal(left: length, top: length, width: length, height: length) {
        viewport.reveal-rect(left, top, width, height);
    }
    public function focus-viewport() { viewport.focus-from-keyboard(); }
}

