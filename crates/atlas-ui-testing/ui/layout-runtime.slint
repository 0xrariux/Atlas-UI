        anchor-eligible: root.anchor-eligible;
        dismiss-on-outside: root.outside-dismiss-enabled;
        label: "Details";
        panel-x: 140px; panel-y: 50px;
        panel-width: 180px; panel-height: 120px;
        dismissed => { root.dismiss-count += 1; root.popover-open = false; }
        focus-restore-requested => {
            root.restore-count += 1;
            invoker.focus-from-keyboard();
        }
        traversal-requested(_) => { root.traversal-count += 1; }
        ActionArea { x: 20px; y: 20px; width: 100px; height: 40px; contained-focus: true; }
    }
    public function focus-invoker() { invoker.focus-from-keyboard(); }
}

