        ];
        query-changed(_) => { root.edit-count += 1; root.suggestions-open = true; }
        suggestion-requested(id) => {
            root.selection = id;
            root.query = id == "alpha" ? "Alpha" : "Beta";
        }
        traversal-requested(_) => { root.traversal-count += 1; }
    }
    public function focus-input() { autocomplete.focus-from-keyboard(); }
}

export component ContainerRuntimeFixture inherits Window {
    out property <length> outer-content-width: outer.content-width;
    out property <length> inner-content-width: inner.content-width;
    out property <length> inner-received-viewport: inner.environment.viewport-width;
    out property <length> inner-content-viewport: inner.content-environment.viewport-width;
    out property <bool> outer-compact: outer.size-class == ContainerSize.compact;
    out property <bool> outer-wide: outer.size-class == ContainerSize.wide;
    out property <bool> inner-compact: inner.size-class == ContainerSize.compact;

    preferred-width: 1200px;
    preferred-height: 260px;

    outer := AtlasContainer {
        x: 20px; y: 20px;
        width: parent.width - 40px;
        height: 200px;
        inset: AtlasGrid.space-4;
        inner := AtlasContainer {
            width: outer.content-width / 2;
            height: outer.content-height;
            inset: AtlasGrid.space-2;
            environment: outer.content-environment;
        }
    }
}

export component LayoutOrderRuntimeFixture inherits Window {
    out property <length> first-x: first.x;
    out property <length> second-x: second.x;
    out property <length> third-x: third.x;
    out property <int> last-focused: focused-id;
    private property <int> focused-id: 0;

    preferred-width: 360px;
    preferred-height: 100px;

    FlexboxLayout {
        x: 10px; y: 10px;
        width: 340px; height: 80px;
        spacing: 10px;
        flex-direction: row;
        flex-wrap: no-wrap;
        first := ActionArea {
            width: 80px; height: 50px;
            layout-order: 2;
            focus-entered(_) => { root.focused-id = 1; }
        }
        second := ActionArea {
            width: 80px; height: 50px;
            layout-order: 0;
            focus-entered(_) => { root.focused-id = 2; }
        }
        third := ActionArea {
            width: 80px; height: 50px;
            layout-order: 1;
            focus-entered(_) => { root.focused-id = 3; }
        }
    }

    public function focus-first() { first.focus-from-keyboard(); }
}

export component RepeatedGridRuntimeFixture inherits Window {
    in-out property <[string]> rows;
    in-out property <bool> show-summary: false;
    out property <length> grid-height: grid.height;

    preferred-width: 280px;
    preferred-height: 400px;

    grid := GridLayout {
        x: 20px; y: 20px;
        width: 220px;
        height: self.preferred-height;
        spacing: 4px;
        for row in root.rows: Row {
            Text { text: row; wrap: word-wrap; }
            Text { text: "1"; }
        }
        if root.show-summary: Row {
            Text { text: "Summary"; colspan: 2; }
        }
    }
}
