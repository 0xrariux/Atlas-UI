import { AtlasGrid, AtlasShape, AtlasTypography, AtlasStatusTokens } from "@atlas-ui-tokens/tokens.slint";

export enum BadgeTone { neutral, healthy, warning, danger, info, live }

// Compact semantic signal for dense rows, labels, avatars, and headings.
// Consumers must provide a meaningful label because color alone is not state.
export component AtlasStatusIndicator inherits Rectangle {
    in property <string> label;
    in property <BadgeTone> tone: BadgeTone.neutral;
    in property <color> indicator-color: root.tone == BadgeTone.healthy ? AtlasStatusTokens.healthy
        : root.tone == BadgeTone.warning ? AtlasStatusTokens.warning
        : root.tone == BadgeTone.danger ? AtlasStatusTokens.danger
        : root.tone == BadgeTone.info ? AtlasStatusTokens.info
        : root.tone == BadgeTone.live ? AtlasStatusTokens.live : AtlasStatusTokens.neutral;

    width: AtlasGrid.space-2;
    height: AtlasGrid.space-2;
    preferred-width: self.width;
    preferred-height: self.height;
    horizontal-stretch: 0;
    background: root.indicator-color;
    border-radius: AtlasShape.radius-round;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label;
}

export component AtlasBadge inherits Rectangle {
    in property <string> text;
    in property <BadgeTone> tone: BadgeTone.neutral;
    in property <bool> dot: false;
    private property <color> tone-color: root.tone == BadgeTone.healthy ? AtlasStatusTokens.healthy
        : root.tone == BadgeTone.warning ? AtlasStatusTokens.warning
        : root.tone == BadgeTone.danger ? AtlasStatusTokens.danger
        : root.tone == BadgeTone.info ? AtlasStatusTokens.info
        : root.tone == BadgeTone.live ? AtlasStatusTokens.live : AtlasStatusTokens.neutral;
    height: AtlasGrid.space-5;
    min-width: badge-text.preferred-width + AtlasGrid.space-4
        + (root.dot ? AtlasGrid.space-2 + AtlasShape.border-width * 2 : AtlasGrid.zero);
    preferred-width: self.min-width;
    max-width: self.min-width;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text; accessible-label: root.text;
    badge-body := Rectangle {
        x: AtlasGrid.zero;
        y: AtlasGrid.zero;
        width: min(parent.width, root.min-width);
        height: parent.height;
        background: root.tone-color.with-alpha(0.08);
        border-width: AtlasShape.border-width;
        border-color: root.tone-color.with-alpha(0.28);
        border-radius: AtlasShape.radius-small;
        accessible-role: AccessibleRole.none;
        if root.dot: Rectangle {
            x: AtlasGrid.space-2;
            y: (parent.height - AtlasGrid.space-1) / 2;
            width: AtlasGrid.space-1; height: AtlasGrid.space-1;
            border-radius: AtlasShape.radius-round; background: root.tone-color; accessible-role: AccessibleRole.none;
        }
        badge-text := Text {
            x: root.dot ? AtlasGrid.space-4 + AtlasShape.border-width * 2 : AtlasGrid.space-2;
            width: parent.width - self.x - AtlasGrid.space-2;
            text: root.text; color: root.tone-color; font-family: AtlasTypography.font-sans;
            font-size: AtlasTypography.size-caption; font-weight: AtlasTypography.weight-semibold;
            horizontal-alignment: center; vertical-alignment: center;
            accessible-role: AccessibleRole.none;
        }
    }
}
