import { AtlasTheme, AtlasGrid, AtlasShape, AtlasTypography, AtlasDensity, AtlasMotion } from "@atlas-ui-tokens/tokens.slint";
import { ActionArea, FocusRing } from "@atlas-ui-core/stable.slint";

export enum SwitchTone { neutral, operator, safety }

export component AtlasSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    in property <string> inactive-label;
    in property <SwitchTone> tone: SwitchTone.neutral;
    in property <bool> enabled: true;
    in property <string> automation-id;
    in property <bool> preview-focus-visible: false;
    // Additive anatomy inputs let dense desktop consumers adapt the visible
    // track without replacing the switch's accessibility and interaction.
    // Defaults preserve the original Atlas switch exactly.
    in property <bool> show-label: true;
    in property <length> track-offset-x: AtlasGrid.space-1;
    in property <length> track-width: AtlasGrid.space-10;
    in property <length> track-height: AtlasGrid.space-6;
    in property <length> track-padding: AtlasGrid.space-1;
    in property <length> track-radius: AtlasShape.radius-round;
    in property <length> track-border-width: AtlasShape.border-width;
    in property <color> track-border-color: root.tone == SwitchTone.safety && root.checked ? AtlasTheme.danger
        : root.tone == SwitchTone.operator && !root.checked ? AtlasTheme.warning
        : root.checked ? AtlasTheme.success : AtlasTheme.border-strong;
    in property <color> track-background: root.checked ? AtlasTheme.surface-selected : AtlasTheme.surface;
    in property <length> thumb-size: AtlasGrid.space-4;
    in property <color> thumb-color: root.checked ? AtlasTheme.success : AtlasTheme.content-secondary;
    callback toggled(bool);

    accessible-role: AccessibleRole.switch;
    accessible-label: root.label;
    accessible-id: root.automation-id;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { action.trigger(); }

    height: AtlasDensity.pointer-target-min;
    min-width: root.show-label
        ? switch-label.preferred-width + AtlasGrid.space-12 + AtlasGrid.space-6
        : root.track-offset-x + root.track-width;
    background: AtlasTheme.transparent;
    opacity: root.enabled ? 1 : 0.55;
    animate opacity { duration: AtlasMotion.fast; }

    track := Rectangle {
        x: root.track-offset-x; y: (parent.height - root.track-height) / 2;
        width: root.track-width; height: root.track-height;
        border-width: root.track-border-width;
        border-color: root.track-border-color;
        border-radius: root.track-radius;
        background: root.track-background;
        animate background { duration: AtlasMotion.fast; }
        animate border-color { duration: AtlasMotion.fast; }
        Rectangle {
            x: root.checked ? parent.width - self.width - root.track-padding : root.track-padding;
            y: (parent.height - self.height) / 2; width: root.thumb-size; height: root.thumb-size;
            border-radius: AtlasShape.radius-round;
            background: root.thumb-color;
            animate x { duration: AtlasMotion.fast; }
            animate background { duration: AtlasMotion.fast; }
        }
        FocusRing {
            x: -(AtlasShape.focus-offset + AtlasShape.focus-width); y: -(AtlasShape.focus-offset + AtlasShape.focus-width);
            width: parent.width + (AtlasShape.focus-offset + AtlasShape.focus-width) * 2;
            height: parent.height + (AtlasShape.focus-offset + AtlasShape.focus-width) * 2;
            active: action.focus-visible || root.preview-focus-visible;
            radius: AtlasShape.radius-round;
        }
    }
    switch-label := Text {
        visible: root.show-label;
        x: AtlasGrid.space-12 + AtlasGrid.space-2;
        width: parent.width - AtlasGrid.space-12 - AtlasGrid.space-2;
        text: root.checked || root.inactive-label == "" ? root.label : root.inactive-label;
        color: AtlasTheme.content-primary; font-family: AtlasTypography.font-sans;
        font-size: AtlasTypography.size-body-small; font-weight: AtlasTypography.weight-semibold;
        vertical-alignment: center; overflow: elide;
    }
    action := ActionArea {
        enabled: root.enabled;
        accessible-name: root.label; automation-id: root.automation-id;
        activated => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}
