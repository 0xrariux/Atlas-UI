import { AtlasTheme, AtlasGrid, AtlasShape, AtlasTypography, AtlasDensity, AtlasOverlayTokens } from "@atlas-ui-tokens/tokens.slint";
import { OverlayFocusController } from "@atlas-ui-core/stable.slint";

export struct MenuItem { id: string, label: string, shortcut: string, enabled: bool, danger: bool }

export component AtlasMenu inherits Rectangle {
    in property <[MenuItem]> items;
    in-out property <int> active-index: 0;
    in property <bool> open: true;
    in property <bool> anchor-eligible: true;
    in property <bool> focus-on-open: true;
    in property <length> maximum-menu-height: AtlasDensity.row-height * 8 + AtlasGrid.space-2;
    out property <length> scroll-offset: -menu-viewport.content-y;
    callback item-requested(string);
    callback dismissed();
    callback traversal-requested(bool /* backwards */);
    callback focus-restore-requested();
    private property <bool> traversal-exit: false;

    width: AtlasOverlayTokens.menu-width;
    height: root.open ? min(max(AtlasGrid.zero, root.maximum-menu-height), root.items.length * AtlasDensity.row-height + AtlasGrid.space-2) : AtlasGrid.zero;
    visible: root.open && root.anchor-eligible;
    clip: true;
    background: AtlasOverlayTokens.background;
    border-width: AtlasShape.border-width; border-color: AtlasOverlayTokens.border; border-radius: AtlasShape.radius-control;
    accessible-role: AccessibleRole.list;
    accessible-label: "Context menu";
    accessible-item-count: root.items.length;

    public function navigate(direction: int) {
        if (root.items.length == 0) { return; }
        if (direction == -2) { root.active-index = 0; }
        else if (direction == 2) { root.active-index = root.items.length - 1; }
        else if (direction < 0) {
            root.active-index = root.active-index <= 0
                ? root.items.length - 1 : root.active-index - 1;
        } else if (direction > 0) {
            root.active-index = root.active-index + 1 >= root.items.length
                ? 0 : root.active-index + 1;
        }
    }

    public function activate-current() {
        if (root.active-index >= 0 && root.active-index < root.items.length
                && root.items[root.active-index].enabled) {
            root.item-requested(root.items[root.active-index].id);
        }
    }

    function reveal-active() {
        if (!root.open || menu-viewport.height <= AtlasGrid.zero
                || root.active-index < 0 || root.active-index >= root.items.length) { return; }
        let top = root.active-index * AtlasDensity.row-height;
        let bottom = top + AtlasDensity.row-height + AtlasGrid.space-2;
        if (top < -menu-viewport.content-y) {
            menu-viewport.content-y = -top;
        } else if (bottom > -menu-viewport.content-y + menu-viewport.height) {
            menu-viewport.content-y = -(bottom - menu-viewport.height);
        }
    }

    menu-viewport := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: root.items.length * AtlasDensity.row-height + AtlasGrid.space-2;
        VerticalLayout {
            width: parent.width;
            padding: AtlasGrid.space-1;
            for item[index] in root.items: Rectangle {
            height: AtlasDensity.row-height;
            border-radius: AtlasShape.radius-small;
            background: root.active-index == index ? AtlasTheme.surface-selected : touch.has-hover ? AtlasTheme.surface-hover : AtlasTheme.transparent;
            opacity: item.enabled ? 1 : 0.55;
            accessible-role: AccessibleRole.list-item;
            accessible-label: item.label;
            accessible-enabled: item.enabled;
            accessible-item-index: index;
            accessible-item-selected: root.active-index == index;
            accessible-action-default => { if (item.enabled) { root.item-requested(item.id); } }
            Text {
                x: AtlasGrid.space-3; width: parent.width - AtlasGrid.space-6;
                text: item.label; color: item.danger ? AtlasTheme.danger : AtlasTheme.content-primary;
                font-family: AtlasTypography.font-sans; font-size: AtlasTypography.size-body-small; vertical-alignment: center;
            }
            Text {
                x: parent.width - self.preferred-width - AtlasGrid.space-3;
                text: item.shortcut; color: AtlasTheme.content-secondary;
                font-family: AtlasTypography.font-mono; font-size: AtlasTypography.size-caption; vertical-alignment: center;
            }
            touch := TouchArea {
                enabled: item.enabled;
                clicked => { root.active-index = index; root.item-requested(item.id); }
            }
            }
        }
    }
    keys := OverlayFocusController {
        active: root.open && root.anchor-eligible;
        directional-navigation: true;
        dismiss-requested => { root.dismissed(); }
        navigation-requested(direction) => { root.navigate(direction); }
        activation-requested => { root.activate-current(); }
        traverse-requested(backwards) => {
            root.traversal-exit = true;
            root.dismissed();
            root.traversal-requested(backwards);
        }
        restore-focus-requested => { root.focus-restore-requested(); }
    }
    changed open => {
        if (root.open) {
            if (!root.anchor-eligible) { root.dismissed(); }
            else {
                root.active-index = root.items.length == 0 ? 0
                    : max(0, min(root.items.length - 1, root.active-index));
                root.reveal-active();
                if (root.focus-on-open) { keys.activate(); }
            }
        } else if (root.traversal-exit) {
            keys.clear();
            root.traversal-exit = false;
        } else { keys.deactivate(); }
    }
    changed anchor-eligible => {
        if (root.open && !root.anchor-eligible) { root.dismissed(); }
    }
    changed items => {
        root.active-index = root.items.length == 0 ? 0
            : max(0, min(root.items.length - 1, root.active-index));
        root.reveal-active();
    }
    changed active-index => { root.reveal-active(); }
    changed maximum-menu-height => { root.reveal-active(); }
}
