// Raw palette values. Only token-layer files may consume these primitives.
// Components must use semantic or role tokens instead.
export global AtlasPalette {
    // Neutral scale
    out property <color> neutral-0: #ffffff;
    out property <color> neutral-25: #f7f9fc;
    out property <color> neutral-50: #edf3fa;
    out property <color> neutral-100: #dbe5ef;
    out property <color> neutral-200: #c3d0dd;
    out property <color> neutral-300: #a7bbcf;
    out property <color> neutral-400: #879aad;
    out property <color> neutral-500: #68798a;
    out property <color> neutral-600: #4d6072;
    out property <color> neutral-700: #3c5063;
    out property <color> neutral-800: #26384a;
    out property <color> neutral-850: #1a2a38;
    out property <color> neutral-900: #101923;
    out property <color> neutral-950: #0b1118;
    out property <color> neutral-1000: #05090e;

    // Brand and semantics
    out property <color> brand-300: #a9dfcc;
    out property <color> brand-500: #65a991;
    out property <color> brand-700: #315e50;
    out property <color> blue-400: #7db7ff;
    out property <color> blue-700: #315a78;
    out property <color> green-400: #7fcca9;
    out property <color> green-700: #306651;
    out property <color> amber-400: #f0c86d;
    out property <color> amber-700: #80652d;
    out property <color> red-400: #e58b8b;
    out property <color> red-700: #784047;

    // Transparent primitives
    out property <color> transparent: #00000000;
    out property <color> shadow-soft: #0000002e;
    out property <color> shadow-strong: #00000052;
    out property <color> grid-minor: #7db7ff12;
    out property <color> grid-major: #7db7ff2b;
}

