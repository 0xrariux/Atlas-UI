import { ScrollView } from "std-widgets.slint";
import {
    AtlasPalette, AtlasTheme, AtlasCategoryTokens, AtlasGrid, AtlasShape, AtlasDensity, AtlasTypography, AtlasOverlayTokens,
    Density, AtlasButton, ButtonTone, AtlasIconButton, IconButtonTone, AtlasTextField, AtlasCheckbox,
    AtlasSwitch, SwitchTone, AtlasBadge, AtlasStatusIndicator, BadgeTone, AtlasIcon, IconName, IconTone, Surface, AtlasScrollbar,
    AtlasTab, AtlasWorkspaceTab, AtlasWorkspaceTabList, TabVariant, AtlasTooltip, TooltipTone, TooltipPlacement, AtlasMenu, MenuItem,
    AtlasModal, AtlasModalFrame, ModalSize, ContentFrame, LayoutGridOverlay
    , AtlasDataTable, AtlasSkeleton, AtlasEmptyState, AtlasErrorState,
    DataColumn, DataRow, DataViewState, DataCellKind, DataCellAlignment,
    CellEditorKind, ColumnPin
    , AtlasPanel, AtlasMetricCard, AtlasMetric, AtlasCopyableValue, AtlasSelectField, AtlasSpinner, AtlasProgressBar, AtlasRadialProgress, ProgressTone,
    AtlasRangeControl, AtlasPagination, AtlasKeyValueList, KeyValueItem, ValueTone, AtlasSettingsRow
    , AtlasChartFrame, AtlasSparkline, SparklineTone, AtlasInlineAlert, AlertTone, AtlasNoticeStack,
    NoticeItem, NoticeTone, AtlasWorkflowBanner, AtlasStepper, StepItem,
    AtlasDrawer, AtlasDrawerFrame, DrawerSide, AtlasErrorPage
    , AtlasHeading, AtlasParagraph, AtlasStyledText, AtlasSelectableText, AtlasInlineCode, AtlasCodeBlock,
    AtlasBlockQuote, AtlasDivider, HeadingLevel, EditorialTone, EditorialEmphasis
    , AtlasEdgeSurface, DividerEdge, AtlasStack, AtlasCluster, AtlasSidebar, AtlasSwitcher, AtlasAutoGrid,
    AtlasColumnGrid, AtlasGridItem,
    AtlasIntrinsicFrame, AtlasSplitView, AtlasSplitPane, AtlasResizeHandle, AtlasStickyRegion,
    LayoutGap, SplitOrientation, StickyEdge
    , AtlasAdmonition, AtlasCallout, AtlasLink, AtlasLinkCard, AtlasRichText, AtlasDocumentList,
    AtlasCaption, AtlasCrossReference, CaptionKind,
    AtlasFootnoteReference, AtlasFootnoteList,
    AtlasDocumentTable, AtlasFigure, MediaState,
    AtlasTerminalBlock, AtlasContentTabs, AdmonitionTone,
    DocumentTableColumn, DocumentTableRow, ContentTabItem
    , AtlasDocumentationShell, DocumentationNavItem, BreadcrumbItem, TocItem, FooterLink
    , AtlasAnchorAction, AtlasDocumentSearch, AtlasCommandPalette,
    DocumentSearchResult, CommandPaletteItem
    , AtlasRoadmapContentTemplate, RoadmapStatusRow, RoadmapStatusTone
    , AtlasSettingsTemplate, AtlasDashboardTemplate
    , AtlasThemeControl
} from "@atlas-ui/components.slint";
import {
    AtlasSettings as GallerySettings, ThemeMode as GalleryThemeMode
} from "@atlas-ui/components.slint";
export {
    AtlasSettings, ThemeMode, Density, MotionPreference, TypographyScale
} from "@atlas-ui/components.slint";

component SectionLabel inherits Text {
    color: AtlasTheme.content-accent;
    font-family: AtlasTypography.font-sans;
    font-size: AtlasTypography.size-body-small;
    font-weight: AtlasTypography.weight-bold;
    vertical-alignment: center;
}

component ColorSwatch inherits Rectangle {
    in property <string> label;
    in property <color> swatch;
    in property <color> foreground: AtlasTheme.content-primary;

    height: AtlasGrid.space-12;
    border-width: AtlasShape.border-width;
    border-color: AtlasTheme.border-subtle;
    border-radius: AtlasShape.radius-small;
    background: swatch;
    Text {
        x: AtlasGrid.space-2;
        width: parent.width - AtlasGrid.space-4;
        text: root.label;
        color: root.foreground;
        font-family: AtlasTypography.font-mono;
        font-size: AtlasTypography.size-label;
        font-weight: AtlasTypography.weight-semibold;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ThemePreview inherits Rectangle {
    in property <bool> light: false;
    private property <color> preview-canvas: light ? AtlasTheme.light-canvas : AtlasTheme.dark-canvas;
    private property <color> preview-surface: light ? AtlasTheme.light-surface : AtlasTheme.dark-surface;
    private property <color> preview-border: light ? AtlasTheme.light-border-subtle : AtlasTheme.dark-border-subtle;

    height: AtlasGrid.space-12 * 3;
    background: preview-canvas;
    border-width: AtlasShape.border-width;
    border-color: preview-border;
    border-radius: AtlasShape.radius-surface;
    Rectangle {
        x: AtlasGrid.space-4;
        y: AtlasGrid.space-4;
        width: parent.width - AtlasGrid.space-8;
        height: parent.height - AtlasGrid.space-8;
        background: root.preview-surface;
        border-width: AtlasShape.border-width;
        border-color: root.preview-border;
        border-radius: AtlasShape.radius-control;
        Text {
            x: AtlasGrid.space-4;
            y: AtlasGrid.space-4;
            width: parent.width - AtlasGrid.space-8;
            height: AtlasGrid.space-6;
            text: root.light ? "LIGHT THEME" : "DARK THEME";
            color: root.light ? AtlasPalette.neutral-950 : AtlasPalette.neutral-50;
            font-family: AtlasTypography.font-sans;
            font-size: AtlasTypography.size-title-small;
            font-weight: AtlasTypography.weight-bold;
            vertical-alignment: center;
        }
        Text {
            x: AtlasGrid.space-4;
            y: AtlasGrid.space-12;
            width: parent.width - AtlasGrid.space-8;
            height: AtlasGrid.space-5;
            text: "Canvas → surface → content → border";
            color: root.light ? AtlasPalette.neutral-600 : AtlasPalette.neutral-300;
            font-family: AtlasTypography.font-sans;
            font-size: AtlasTypography.size-body-small;
            vertical-alignment: center;
        }
    }
}

component DensityPreview inherits Rectangle {
    in property <string> label;
    in property <Density> preview-density: Density.normal;

    height: (root.preview-density == Density.compact
        ? AtlasDensity.control-height-compact
        : root.preview-density == Density.comfortable
            ? AtlasDensity.control-height-comfortable
            : AtlasDensity.control-height-normal) + AtlasGrid.space-4;
    background: AtlasTheme.transparent;
    HorizontalLayout {
        spacing: AtlasGrid.space-4;
        Text {
            width: AtlasGrid.column-min-width * 2;
            text: root.label;
            color: AtlasTheme.content-secondary;
            font-family: AtlasTypography.font-mono;
            font-size: AtlasTypography.size-body-small;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            background: AtlasTheme.transparent;
            AtlasButton {
                width: AtlasGrid.column-min-width * 2 + AtlasGrid.space-8;
                text: "Default action";
                density: root.preview-density;
                tone: ButtonTone.primary;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: AtlasTheme.transparent;
            AtlasButton {
                width: AtlasGrid.column-min-width * 2 + AtlasGrid.space-8;
                text: "Secondary";
                density: root.preview-density;
            }
        }
    }
}

component InteractionStatePreview inherits Rectangle {
    in property <string> state-name;
    in property <string> detail;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <bool> focus-visible: false;

    height: AtlasDensity.control-height-comfortable + AtlasGrid.space-6;
    background: root.selected ? AtlasTheme.surface-selected : AtlasTheme.surface;
    border-width: AtlasShape.border-width;
    border-color: root.focus-visible ? AtlasTheme.focus-ring : AtlasTheme.border-subtle;
    border-radius: AtlasShape.radius-control;
    opacity: root.disabled ? 0.55 : 1;

    VerticalLayout {
        padding: AtlasGrid.space-3;
        spacing: AtlasGrid.space-1;
        Text {
            text: root.state-name;
            color: AtlasTheme.content-primary;
            font-family: AtlasTypography.font-sans;
            font-size: AtlasTypography.size-body-small;
            font-weight: AtlasTypography.weight-semibold;
        }
        Text {
            text: root.detail;
            color: AtlasTheme.content-secondary;
            font-family: AtlasTypography.font-mono;
            font-size: AtlasTypography.size-caption;
        }
    }
}

component ScrollbarPreview inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> overflow: true;

    background: AtlasTheme.canvas;
    border-width: AtlasShape.border-width;
    border-color: AtlasTheme.border-subtle;
    border-radius: AtlasShape.radius-small;
    clip: true;

    Text {
        x: AtlasGrid.space-3;
        y: AtlasGrid.space-2;
        text: root.label;
        color: AtlasTheme.content-secondary;
        font-family: AtlasTypography.font-mono;
        font-size: AtlasTypography.size-caption;
    }
    Rectangle { x: AtlasGrid.space-3; y: AtlasGrid.space-8; width: parent.width / 2; height: AtlasGrid.hairline; background: AtlasTheme.border-subtle; }
    Rectangle { x: AtlasGrid.space-3; y: AtlasGrid.space-12; width: parent.width * 0.7; height: AtlasGrid.hairline; background: AtlasTheme.border-subtle; }
    Rectangle { x: AtlasGrid.space-3; y: AtlasGrid.space-12 + AtlasGrid.space-4; width: parent.width * 0.42; height: AtlasGrid.hairline; background: AtlasTheme.border-subtle; }
    AtlasScrollbar {
        x: parent.width - self.width;
        height: parent.height;
        viewport-y: root.active ? self.height * 1.2 : self.height * 0.4;
        viewport-height: self.height;
        content-height: root.overflow ? self.height * 3 : self.height;
        preview-active: root.active;
        accessible-label: root.label + " scroll position";
    }
}

component EditorialArticlePreview inherits Rectangle {
    min-height: AtlasGrid.space-12 * 13;
    background: AtlasTheme.transparent;
    VerticalLayout { spacing: AtlasGrid.space-4;
        AtlasHeading {
            height: root.width <= AtlasTypography.measure-compact
                ? AtlasTypography.line-display * 2.5
                : AtlasTypography.line-display * 2;
            text: "Designing native interfaces with a web-quality rhythm";
            level: HeadingLevel.h1; anchor-id: "editorial-foundations";
        }
        AtlasParagraph {
            height: AtlasTypography.line-lead * 2;
            text: "Atlas separates editorial hierarchy from application composition. Typography remains semantic, responsive and independent from domain content.";
            lead: true; muted: true;
        }
        AtlasInlineCode { width: AtlasGrid.column-min-width * 3; height: AtlasGrid.space-6; code: "cargo add atlas-ui"; }
        AtlasDivider { height: AtlasGrid.space-6; label: "FOUNDATIONS"; }
        AtlasHeading { height: AtlasTypography.line-heading; text: "Readable by construction"; level: HeadingLevel.h2; }
        AtlasParagraph {
            height: AtlasTypography.line-body * 3;
            text: "A bounded measure, deliberate hierarchy and shared spacing tokens make long-form native content predictable. Applications provide meaning; Atlas owns presentation and accessibility contracts.";
        }
        AtlasBlockQuote {
            height: AtlasGrid.space-12 * 2;
            quote: "A component library becomes valuable when consistency is easier than improvisation.";
            attribution: "Atlas design principle";
        }
        AtlasCodeBlock {
            height: AtlasGrid.space-12 * 2;
            language: "rust";
            code: "let document = DocumentModel::from_blocks(blocks);\nui.set_document(document.into());";
        }
    }
}

component EditorialScalePreview inherits Rectangle {
    min-height: AtlasGrid.space-12 * 8;
    background: AtlasTheme.transparent;
    VerticalLayout { spacing: AtlasGrid.space-3;
        AtlasHeading { height: AtlasTypography.line-heading; text: "Type scale"; level: HeadingLevel.h2; }
        AtlasHeading { height: AtlasTypography.line-heading; text: "Heading level 3"; level: HeadingLevel.h3; }
        AtlasHeading { height: AtlasTypography.line-heading-small; text: "Heading level 4"; level: HeadingLevel.h4; }
        AtlasHeading { height: AtlasTypography.line-heading-small; text: "Heading level 5"; level: HeadingLevel.h5; }
        AtlasHeading { height: AtlasTypography.line-body; text: "Heading level 6"; level: HeadingLevel.h6; }
        AtlasDivider { height: AtlasGrid.space-6; }
        AtlasParagraph { height: AtlasTypography.line-body * 3; text: "Body text keeps a stable reading measure and wraps naturally when the viewport narrows. Secondary content remains legible without competing with the primary hierarchy."; muted: true; }
        AtlasHeading { height: AtlasTypography.line-heading-small; text: "Semantic tones"; level: HeadingLevel.h4; }
        AtlasHeading { height: AtlasTypography.line-body; text: "Accent heading"; level: HeadingLevel.h6; tone: EditorialTone.accent; }
        AtlasHeading { height: AtlasTypography.line-body; text: "Danger heading"; level: HeadingLevel.h6; tone: EditorialTone.danger; }
    }
}

component IconPreview inherits Rectangle {
    in property <IconName> icon-name;
    in property <IconTone> tone: IconTone.primary;
    in property <string> label;
    height: AtlasGrid.space-12 * 2;
    background: AtlasTheme.surface;
    border-width: AtlasShape.border-width;
    border-color: AtlasTheme.border-subtle;
    border-radius: AtlasShape.radius-control;
    AtlasIcon {
        x: (parent.width - self.width) / 2; y: AtlasGrid.space-4;
        size: AtlasGrid.space-6; name: root.icon-name;
        tone: root.tone;
        decorative: false;
        accessible-name: root.label + " icon";
    }
    Text {
        x: AtlasGrid.space-2; y: AtlasGrid.space-12;
        width: parent.width - AtlasGrid.space-4; height: AtlasGrid.space-5;
        text: root.label; color: AtlasTheme.content-secondary;
        font-family: AtlasTypography.font-mono; font-size: AtlasTypography.size-caption;
        horizontal-alignment: center; overflow: elide;
    }
}

component RecipeCard inherits Rectangle {
    in property <string> label;
    min-width: AtlasGrid.column-min-width * 2;
    min-height: AtlasGrid.space-12 * 2;
    background: AtlasTheme.surface;
    border-width: AtlasShape.border-width;
    border-color: AtlasTheme.border-subtle;
    border-radius: AtlasShape.radius-control;
    Text {
        x: AtlasGrid.space-3; width: parent.width - AtlasGrid.space-6;
        text: root.label; color: AtlasTheme.content-primary;
        font-family: AtlasTypography.font-sans; font-size: AtlasTypography.size-body-small;
        font-weight: AtlasTypography.weight-semibold; vertical-alignment: center;
        horizontal-alignment: center; overflow: elide;
    }
}

export component Gallery inherits Window {
    in property <bool> show-grid: false;
    in property <string> preview-page: "foundations";

    title: "Atlas UI · Foundation system";
    preferred-width: 1080px;
    preferred-height: 900px;
    background: AtlasTheme.canvas;

    frame := ContentFrame { reference-width: root.width; }

    ScrollView {
        viewport-width: root.width;
        VerticalLayout {
            x: frame.content-x;
            width: frame.content-width;
            padding-top: AtlasGrid.space-8;
            padding-bottom: AtlasGrid.space-8;
            spacing: AtlasGrid.space-6;

            Text {
                height: AtlasTypography.line-display;
                text: root.preview-page == "rich-content" ? "ATLAS UI RICH CONTENT"
                    : root.preview-page == "responsive" ? (root.width < AtlasGrid.breakpoint-compact ? "ATLAS UI RESPONSIVE" : "ATLAS UI RESPONSIVE RECIPES")
                    : root.preview-page == "icons" ? "ATLAS UI VECTOR ICONS"
                    : root.preview-page == "typography-stress"
                        ? (root.width < AtlasGrid.breakpoint-compact ? "TYPOGRAPHY STRESS" : "ATLAS UI TYPOGRAPHY STRESS")
                    : root.preview-page == "editorial" ? "ATLAS UI EDITORIAL SYSTEM"
                    : root.preview-page == "final" ? "ATLAS UI FINAL MIGRATION"
                    : root.preview-page == "wave" ? "ATLAS UI COMPONENT WAVE"
                    : root.preview-page == "data-rich" ? "RESPONSIVE ACCESS MATRIX"
                    : root.preview-page == "data" ? "ATLAS UI DATA SYSTEM"
                    : root.preview-page == "navigation" ? "ATLAS UI OVERLAYS & NAVIGATION"
                    : root.preview-page == "components" ? "ATLAS UI COMPONENTS"
                    : root.preview-page == "interactions" ? "ATLAS UI INTERACTIONS" : "ATLAS UI FOUNDATIONS";
                color: AtlasTheme.content-primary;
                font-family: AtlasTypography.font-sans;
                font-size: AtlasTypography.size-display;
                font-weight: AtlasTypography.weight-bold;
            }
            Text {
                visible: root.preview-page != "components" && root.preview-page != "navigation" && root.preview-page != "data" && root.preview-page != "data-rich" && root.preview-page != "wave" && root.preview-page != "final" && root.preview-page != "editorial" && root.preview-page != "typography-stress" && root.preview-page != "icons" && root.preview-page != "responsive" && root.preview-page != "rich-content";
                height: self.visible ? AtlasTypography.line-body : AtlasGrid.zero;
                text: root.preview-page == "components"
                    ? "Shared foundations → consistent contracts → production-ready composition"
                    : root.preview-page == "interactions"
                    ? "Input modality → observable state → accessible intent → visual component"
                    : "Primitive palette → semantic theme → geometry → component roles";
                color: AtlasTheme.content-secondary;
                font-family: AtlasTypography.font-sans;
                font-size: AtlasTypography.size-body;
            }

            if root.preview-page == "foundations": VerticalLayout {
            spacing: AtlasGrid.space-6;
            SectionLabel { visible: root.preview-page == "foundations"; text: "THEME MATRIX"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            HorizontalLayout {
                visible: root.preview-page == "foundations";
                height: self.visible ? AtlasGrid.space-12 * 3 : AtlasGrid.zero;
                spacing: AtlasGrid.gutter-normal;
                ThemePreview { horizontal-stretch: 1; }
                ThemePreview { horizontal-stretch: 1; light: true; }
            }

            SectionLabel { visible: root.preview-page == "foundations"; text: "ACTIVE SEMANTIC COLORS"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            HorizontalLayout {
                visible: root.preview-page == "foundations";
                height: self.visible ? AtlasGrid.space-12 : AtlasGrid.zero;
                spacing: AtlasGrid.space-2;
                ColorSwatch { horizontal-stretch: 1; label: "canvas"; swatch: AtlasTheme.canvas; foreground: AtlasTheme.content-primary; }
                ColorSwatch { horizontal-stretch: 1; label: "surface"; swatch: AtlasTheme.surface; foreground: AtlasTheme.content-primary; }
                ColorSwatch { horizontal-stretch: 1; label: "content"; swatch: AtlasTheme.content-primary; foreground: AtlasTheme.canvas; }
                ColorSwatch { horizontal-stretch: 1; label: "accent"; swatch: AtlasTheme.content-accent; foreground: AtlasTheme.on-accent; }
                ColorSwatch { horizontal-stretch: 1; label: "success"; swatch: AtlasTheme.success; foreground: AtlasTheme.on-success; }
                ColorSwatch { horizontal-stretch: 1; label: "warning"; swatch: AtlasTheme.warning; foreground: AtlasTheme.on-warning; }
                ColorSwatch { horizontal-stretch: 1; label: "danger"; swatch: AtlasTheme.danger; foreground: AtlasTheme.on-danger; }
                ColorSwatch { horizontal-stretch: 1; label: "info"; swatch: AtlasTheme.info; foreground: AtlasTheme.on-info; }
            }

            SectionLabel { visible: root.preview-page == "foundations"; text: "CATEGORICAL IDENTITY · NEVER STATUS"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            HorizontalLayout {
                visible: root.preview-page == "foundations";
                height: self.visible ? AtlasGrid.space-12 : AtlasGrid.zero;
                spacing: AtlasGrid.space-2;
                ColorSwatch { horizontal-stretch: 1; label: "category-1"; swatch: AtlasCategoryTokens.category-1; foreground: AtlasTheme.canvas; }
                ColorSwatch { horizontal-stretch: 1; label: "category-2"; swatch: AtlasCategoryTokens.category-2; foreground: AtlasTheme.canvas; }
                ColorSwatch { horizontal-stretch: 1; label: "category-3"; swatch: AtlasCategoryTokens.category-3; foreground: AtlasTheme.canvas; }
                ColorSwatch { horizontal-stretch: 1; label: "category-4"; swatch: AtlasCategoryTokens.category-4; foreground: AtlasTheme.canvas; }
                ColorSwatch { horizontal-stretch: 1; label: "category-5"; swatch: AtlasCategoryTokens.category-5; foreground: AtlasTheme.canvas; }
                ColorSwatch { horizontal-stretch: 1; label: "category-6"; swatch: AtlasCategoryTokens.category-6; foreground: AtlasTheme.canvas; }
            }

            SectionLabel { visible: root.preview-page == "foundations"; text: "DENSITY MATRIX"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            Surface {
                visible: root.preview-page == "foundations";
                height: self.visible
                    ? AtlasDensity.control-height-compact
                        + AtlasDensity.control-height-normal
                        + AtlasDensity.control-height-comfortable
                        + AtlasGrid.space-12 * 2 + AtlasGrid.space-6
                    : AtlasGrid.zero;
                raised: true;
                VerticalLayout {
                    padding: AtlasGrid.space-4;
                    spacing: AtlasGrid.space-2;
                    HorizontalLayout {
                        height: AtlasGrid.space-4;
                        spacing: AtlasGrid.space-4;
                        Text {
                            width: AtlasGrid.column-min-width * 2;
                            text: "DENSITY";
                            color: AtlasTheme.content-secondary;
                            font-family: AtlasTypography.font-sans;
                            font-size: AtlasTypography.size-label;
                            font-weight: AtlasTypography.weight-bold;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "PRIMARY";
                            color: AtlasTheme.content-secondary;
                            font-family: AtlasTypography.font-sans;
                            font-size: AtlasTypography.size-label;
                            font-weight: AtlasTypography.weight-bold;
                            horizontal-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "SECONDARY";
                            color: AtlasTheme.content-secondary;
                            font-family: AtlasTypography.font-sans;
                            font-size: AtlasTypography.size-label;
                            font-weight: AtlasTypography.weight-bold;
                            horizontal-alignment: center;
                        }
                    }
                    DensityPreview { label: "compact"; preview-density: Density.compact; }
                    DensityPreview { label: "normal"; preview-density: Density.normal; }
                    DensityPreview { label: "comfortable"; preview-density: Density.comfortable; }
                }
            }

            SectionLabel { visible: root.preview-page == "foundations"; text: "INTERACTION STATES"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            Surface {
                visible: root.preview-page == "foundations";
                height: self.visible ? AtlasDensity.control-height-comfortable + AtlasGrid.space-8 : AtlasGrid.zero;
                raised: true;
                HorizontalLayout {
                    padding: AtlasGrid.space-4;
                    spacing: AtlasGrid.space-3;
                    alignment: center;
                    Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
                    AtlasButton { width: root.width < AtlasGrid.content-standard ? AtlasGrid.column-min-width + AtlasGrid.space-10 : AtlasGrid.column-min-width * 2; text: "Neutral"; }
                    AtlasButton { width: root.width < AtlasGrid.content-standard ? AtlasGrid.column-min-width + AtlasGrid.space-10 : AtlasGrid.column-min-width * 2; text: "Primary"; tone: ButtonTone.primary; }
                    AtlasButton { width: root.width < AtlasGrid.content-standard ? AtlasGrid.column-min-width + AtlasGrid.space-10 : AtlasGrid.column-min-width * 2; text: "Danger"; tone: ButtonTone.danger; }
                    AtlasButton { width: root.width < AtlasGrid.content-standard ? AtlasGrid.column-min-width + AtlasGrid.space-10 : AtlasGrid.column-min-width * 2; text: "Disabled"; enabled: false; }
                    AtlasButton { width: root.width < AtlasGrid.content-standard ? AtlasGrid.column-min-width * 2 : AtlasGrid.column-min-width * 2 + AtlasGrid.space-8; text: "Keyboard focus"; preview-focus-visible: true; }
                    Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
                }
            }

            }

            if root.preview-page == "interactions": VerticalLayout {
            spacing: AtlasGrid.space-6;
            SectionLabel { visible: root.preview-page == "interactions"; text: "ACTION AREA STATE CONTRACT"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            HorizontalLayout {
                visible: root.preview-page == "interactions";
                height: self.visible ? AtlasDensity.control-height-comfortable + AtlasGrid.space-6 : AtlasGrid.zero;
                spacing: AtlasGrid.space-3;
                InteractionStatePreview { horizontal-stretch: 1; state-name: "Rest"; detail: "focus=false · pressed=false"; }
                InteractionStatePreview { horizontal-stretch: 1; state-name: "Selected"; detail: "selected=true"; selected: true; }
                InteractionStatePreview { horizontal-stretch: 1; state-name: "Focus visible"; detail: "modality=keyboard"; focus-visible: true; }
                InteractionStatePreview { horizontal-stretch: 1; state-name: "Disabled"; detail: "enabled=false"; disabled: true; }
            }

            SectionLabel { visible: root.preview-page == "interactions"; text: "ACTIVATION CONTRACT"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            Surface {
                visible: root.preview-page == "interactions";
                height: self.visible ? AtlasDensity.control-height-comfortable + AtlasGrid.space-8 : AtlasGrid.zero;
                raised: true;
                HorizontalLayout {
                    padding: AtlasGrid.space-4;
                    spacing: AtlasGrid.space-3;
                    alignment: center;
                    AtlasButton { text: "Pointer / Enter / Space"; tone: ButtonTone.primary; preview-focus-visible: true; }
                    AtlasButton { text: "Selected action"; selected: true; }
                    AtlasButton { text: "Unavailable"; enabled: false; }
                    Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
                }
            }

            SectionLabel { visible: root.preview-page == "interactions"; text: "CONTROLLED SCROLLBAR ANATOMY"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            Surface {
                visible: root.preview-page == "interactions";
                height: self.visible ? AtlasGrid.space-12 * 3 : AtlasGrid.zero;
                raised: true;
                HorizontalLayout {
                    padding: AtlasGrid.space-4;
                    spacing: AtlasGrid.space-4;
                    ScrollbarPreview { horizontal-stretch: 1; label: "IDLE · PROPORTIONAL"; }
                    ScrollbarPreview { horizontal-stretch: 1; label: "ACTIVE · CONTROLLED"; active: true; }
                    ScrollbarPreview { horizontal-stretch: 1; label: "FITS · HIDDEN"; overflow: false; }
                }
            }

            SectionLabel { visible: root.preview-page == "interactions"; text: "CONTROLLED GROUPS"; height: self.visible ? AtlasGrid.space-4 : AtlasGrid.zero; }
            Surface {
                visible: root.preview-page == "interactions";
                height: self.visible ? AtlasGrid.space-12 * 2 : AtlasGrid.zero;
                raised: true;
                VerticalLayout {
                    padding: AtlasGrid.space-4;
                    spacing: AtlasGrid.space-3;
                    Text {
                        text: "SelectionController  →  single · additive · range intentions";
                        color: AtlasTheme.content-primary;
                        font-family: AtlasTypography.font-mono;
                        font-size: AtlasTypography.size-body-small;
                    }
                    Text {
                        text: "RovingFocusController →  previous · next · first · last · wrap";
                        color: AtlasTheme.content-secondary;
                        font-family: AtlasTypography.font-mono;
                        font-size: AtlasTypography.size-body-small;
                    }
                }
            }

            }

            Text {
                visible: root.preview-page != "components" && root.preview-page != "navigation" && root.preview-page != "data" && root.preview-page != "data-rich" && root.preview-page != "wave" && root.preview-page != "final" && root.preview-page != "editorial" && root.preview-page != "typography-stress" && root.preview-page != "icons" && root.preview-page != "responsive" && root.preview-page != "rich-content";
                height: self.visible ? self.preferred-height : AtlasGrid.zero;
                text: root.preview-page == "interactions"
                    ? "Accessible role + name + default action · reduced motion resolves durations to zero"
                    : "Grid unit 4 · semantic tokens · no arbitrary component literals";
                color: AtlasTheme.content-secondary;
                font-family: AtlasTypography.font-mono;
                font-size: AtlasTypography.size-caption;
            }
        }
    }

    if root.preview-page == "components": Rectangle {
        x: frame.content-x;
        y: AtlasGrid.space-12 * 2 + AtlasGrid.space-4;
        width: frame.content-width;
        height: parent.height - self.y - AtlasGrid.space-8;
        background: AtlasTheme.canvas;
        VerticalLayout {
            spacing: AtlasGrid.space-5;
            Text {
                text: "Shared foundations → consistent contracts → production-ready composition";
                color: AtlasTheme.content-secondary;
                font-family: AtlasTypography.font-sans;
                font-size: AtlasTypography.size-body;
                height: AtlasGrid.space-5;
            }
            SectionLabel { text: "BUTTONS"; height: AtlasGrid.space-4; }
            HorizontalLayout {
                height: AtlasDensity.control-height-comfortable;
                spacing: AtlasGrid.space-3;
                AtlasButton { text: "Primary action"; tone: ButtonTone.primary; }
                AtlasButton { text: "With icon"; show-icon: true; icon-name: IconName.check; }
                AtlasButton { text: "Danger"; tone: ButtonTone.danger; }
                AtlasButton { text: "Loading"; loading: true; }
                AtlasButton { text: "Disabled"; enabled: false; }
                Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
            }
            SectionLabel { text: "ICON BUTTONS · POINTER TARGETS · FOCUS"; height: AtlasGrid.space-4; }
            HorizontalLayout {
                height: AtlasDensity.control-height-comfortable;
                spacing: AtlasGrid.space-3;
                AtlasIconButton { icon-name: IconName.add; accessible-label: "Add item"; }
                AtlasIconButton { icon-name: IconName.play; accessible-label: "Start"; tone: IconButtonTone.primary; }
                AtlasIconButton { icon-name: IconName.stop; accessible-label: "Stop"; tone: IconButtonTone.danger; preview-focus-visible: true; }
                AtlasIconButton { icon-name: IconName.grid; accessible-label: "Grid selected"; toggle: true; selected: true; }
                AtlasIconButton { icon-name: IconName.refresh; accessible-label: "Loading metrics"; loading: true; }
                AtlasIconButton { icon-name: IconName.close; accessible-label: "Unavailable close"; enabled: false; }
                Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
            }
            SectionLabel { text: "TEXT FIELDS"; height: AtlasGrid.space-4; }
            HorizontalLayout {
                height: AtlasGrid.space-12 * 2;
                spacing: AtlasGrid.space-4;
                AtlasTextField { horizontal-stretch: 1; label: "Project name"; value: "Atlas UI"; hint: "Visible to the whole workspace"; required: true; }
                AtlasTextField { horizontal-stretch: 1; label: "Repository"; value: "atlas/ui-library"; mono: true; }
                AtlasTextField { horizontal-stretch: 1; label: "Identifier"; value: "invalid value"; error: "Use lowercase letters and hyphens"; }
                AtlasTextField { horizontal-stretch: 1; label: "Unavailable"; value: "Read only"; enabled: false; }
            }
            SectionLabel { text: "CHOICES"; height: AtlasGrid.space-4; }
            HorizontalLayout {
                height: AtlasGrid.space-12;
                spacing: AtlasGrid.space-6;
                AtlasCheckbox { width: AtlasGrid.column-min-width * 3; label: "Unchecked option"; }
                AtlasCheckbox { width: AtlasGrid.column-min-width * 4; label: "Checked option"; description: "Supporting description"; checked: true; preview-focus-visible: true; }
                AtlasCheckbox { width: AtlasGrid.column-min-width * 3; label: "Disabled option"; enabled: false; }
                Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
            }
            HorizontalLayout {
                height: AtlasDensity.pointer-target-min;
                spacing: AtlasGrid.space-6;
                AtlasSwitch { width: AtlasGrid.column-min-width * 3; label: "Enabled"; inactive-label: "Disabled"; checked: true; }
                AtlasSwitch { width: AtlasGrid.column-min-width * 4; label: "Operator active"; inactive-label: "Operator paused"; tone: SwitchTone.operator; }
                AtlasSwitch { width: AtlasGrid.column-min-width * 3; label: "Safety override"; tone: SwitchTone.safety; checked: true; preview-focus-visible: true; }
                AtlasSwitch {
                    width: 32px; height: 16px; show-label: false; label: "Compact custom track"; checked: true;
                    track-offset-x: 0px; track-width: 32px; track-height: 16px; track-padding: 2px;
                    track-border-width: 0px; thumb-size: 12px;
                }
                Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
            }
            AtlasSettingsRow {
                height: AtlasGrid.space-12;
                title: "Automatic deployment";
                description: "Apply validated releases without another confirmation.";
                AtlasSwitch {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    width: AtlasGrid.column-min-width * 2;
                    label: "Automatic deployment";
                    show-label: false;
                    checked: true;
                }
            }
            AtlasSettingsRow {
                height: AtlasGrid.space-12;
                title: "Archived environment";
                description: "Unavailable settings preserve their semantic grouping.";
                enabled: false;
                show-divider: true;
                AtlasButton {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    width: AtlasGrid.column-min-width * 2;
                    text: "Review";
                    enabled: false;
                }
            }
            SectionLabel { text: "STATUS BADGES"; height: AtlasGrid.space-4; }
            HorizontalLayout {
                height: AtlasGrid.space-6;
                spacing: AtlasGrid.space-2;
                AtlasBadge { text: "Neutral"; }
                AtlasBadge { text: "Healthy"; tone: BadgeTone.healthy; dot: true; }
                AtlasBadge { text: "Warning"; tone: BadgeTone.warning; dot: true; }
                AtlasBadge { text: "Danger"; tone: BadgeTone.danger; dot: true; }
                AtlasBadge { text: "Information"; tone: BadgeTone.info; }
                AtlasBadge { text: "Live"; tone: BadgeTone.live; dot: true; }
                AtlasStatusIndicator { label: "Healthy signal"; tone: BadgeTone.healthy; }
                AtlasStatusIndicator { label: "Warning signal"; tone: BadgeTone.warning; }
                AtlasStatusIndicator { label: "Danger signal"; tone: BadgeTone.danger; }
                AtlasStatusIndicator { label: "Live signal"; tone: BadgeTone.live; }
                AtlasStatusIndicator { label: "Neutral signal"; tone: BadgeTone.neutral; }
                AtlasStatusIndicator { label: "Information signal"; tone: BadgeTone.info; }
                AtlasStatusIndicator { label: "Custom product signal"; indicator-color: AtlasCategoryTokens.category-3; }
                Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
            }
        }
    }

    if root.preview-page == "navigation": Rectangle {
        x: frame.content-x; y: AtlasGrid.space-12 * 2 + AtlasGrid.space-4;
        width: frame.content-width; height: parent.height - self.y - AtlasGrid.space-6;
        background: AtlasTheme.transparent;
        VerticalLayout {
            spacing: AtlasGrid.space-5;
            Text {
                text: "Focus boundaries → roving navigation → accessible transient surfaces";
                color: AtlasTheme.content-secondary; font-family: AtlasTypography.font-sans;
                font-size: AtlasTypography.size-body; height: AtlasGrid.space-5;
            }
            SectionLabel { text: "TABS · ROVING FOCUS CONTRACT"; height: AtlasGrid.space-4; }
            workspace-tabs := AtlasWorkspaceTabList {
                height: AtlasDensity.row-height;
