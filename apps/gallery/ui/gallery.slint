                            width: parent.width; height: parent.height;
                            title: "Ready · cache hit";
                            meta: "guide / en / v3 · shared allocation";
                            VerticalLayout {
                                padding: AtlasGrid.space-4; spacing: AtlasGrid.space-3;
                                AtlasBadge { text: "READY"; tone: BadgeTone.healthy; }
                                AtlasParagraph {
                                    height: AtlasTypography.line-body * 3;
                                    text: "The cached source is reused through Arc<str>; parsing and rendering remain separate stages.";
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: loading-grid.item-basis;
                        height: root.width < AtlasGrid.breakpoint-compact
                            ? (loading-grid.height - AtlasGrid.space-4 * 4) / 5
                            : (loading-grid.height - AtlasGrid.space-4 * 2) / 3;
                        background: AtlasTheme.transparent;
                        AtlasErrorState {
                            width: parent.width; height: parent.height;
                            title: "Source unavailable";
                            message: "The configured adapter failed explicitly. Atlas never switches to a fixture or remote source.";
                            retry-label: "Retry explicitly";
                        }
                    }
                }
                AtlasCallout {
                    height: AtlasGrid.space-12 * 3;
                    compact: true;
                    tone: AdmonitionTone.caution;
                    title: "Budgets and obsolescence";
                    body: "Default limits: 64 revisions, 8 MiB cache, 512 KiB per source. A newer route or cancellation makes every late completion stale.";
