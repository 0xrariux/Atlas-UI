                        border-width: AtlasShape.border-width;
                        border-color: AtlasTheme.border-subtle; border-radius: AtlasShape.radius-surface;
                        background: AtlasTheme.surface;
                        AtlasModalFrame {
                            x: AtlasGrid.space-3; y: AtlasGrid.space-3;
                            width: parent.width - AtlasGrid.space-6; height: parent.height - AtlasGrid.space-6;
                            open: true; contained: true; panel-width: AtlasOverlayTokens.modal-width-small;
                            panel-height: AtlasGrid.space-12 * 5; panel-border-color: AtlasTheme.danger;
                            label: "Delete this environment?";
                            description: "This preview demonstrates a contained modal, its semantic danger state and the shared focus boundary.";
                            VerticalLayout {
                                width: parent.width; height: parent.height;
                                padding: AtlasGrid.space-6; spacing: AtlasGrid.space-3;
                                Text { text: "Delete environment?"; color: AtlasTheme.content-primary; font-family: AtlasTypography.font-sans; font-size: AtlasTypography.size-title; font-weight: AtlasTypography.weight-bold; }
                                Text { text: "CUSTOM FRAME CONTENT"; color: AtlasTheme.danger; font-family: AtlasTypography.font-mono; font-size: AtlasTypography.size-body-small; font-weight: AtlasTypography.weight-semibold; }
                                Text { text: "This preview demonstrates a contained modal, its semantic danger state and the shared focus boundary."; color: AtlasTheme.content-secondary; font-family: AtlasTypography.font-sans; font-size: AtlasTypography.size-body; wrap: word-wrap; vertical-stretch: 1; }
                                HorizontalLayout { height: AtlasGrid.space-10; spacing: AtlasGrid.space-2; alignment: end;
                                    AtlasButton { text: "Keep environment"; tone: ButtonTone.secondary; }
                                    AtlasButton { text: "Delete"; tone: ButtonTone.danger; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.preview-page == "data": Rectangle {
        x: frame.content-x; y: AtlasGrid.space-12 * 2 + AtlasGrid.space-4;
