    if root.preview-page == "wave": Rectangle {
        x: frame.content-x; y: AtlasGrid.space-12 * 2 + AtlasGrid.space-4; width: frame.content-width; height: parent.height - self.y - AtlasGrid.space-6;
        background: AtlasTheme.transparent;
        VerticalLayout { spacing: AtlasGrid.space-5;
            Text { text: "Composed primitives → bounded inputs → reusable information surfaces"; color: AtlasTheme.content-secondary; font-family: AtlasTypography.font-sans; font-size: AtlasTypography.size-body; height: AtlasGrid.space-5; }
            HorizontalLayout { height: AtlasGrid.space-12 * 3; spacing: AtlasGrid.space-4;
                AtlasMetricCard { horizontal-stretch: 1; label: "Availability"; value: "99.98%"; meta: "+0.12% this month"; tone: ValueTone.positive; }
                AtlasMetricCard { horizontal-stretch: 1; label: "Monthly spend"; value: "€ 12,480"; meta: "72% of budget"; tone: ValueTone.accent; }
                AtlasSelectField { horizontal-stretch: 1; label: "Environment"; value: "Production"; hint: "Bounded option set"; required: true; }
