                    AtlasSkeleton { height: AtlasGrid.space-12 * 2; lines: 3; }
                    AtlasEmptyState { height: AtlasGrid.space-12 * 2; title: "No matching rows"; message: "Clear active filters to see all environments."; }
                    AtlasErrorState { height: AtlasGrid.space-12 * 2; title: "Sync failed"; message: "The cached rows remain available."; }
                }
