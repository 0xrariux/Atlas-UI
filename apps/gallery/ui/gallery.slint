                tab-count: 3; selected-index: 0;
                overview-workspace-tab := AtlasWorkspaceTab { tab-id: "overview"; text: "Overview"; selected: true; closable: true; active-in-roving-group: true; index: 0; count: 3; preview-focus-visible: true; }
                terminal-workspace-tab := AtlasWorkspaceTab { tab-id: "terminal"; text: "Terminal session with a deliberately long label"; closable: true; dirty: true; index: 1; count: 3; }
                AtlasWorkspaceTab { tab-id: "disabled"; text: "Disabled"; enabled: false; closable: true; index: 2; count: 3; }
                focus-requested(index) => {
                    if (index == 0) { overview-workspace-tab.focus-from-group(); }
                    if (index == 1) { terminal-workspace-tab.focus-from-group(); }
                }
            }
            HorizontalLayout {
                height: AtlasDensity.row-height; spacing: AtlasGrid.space-2;
                AtlasTab { text: "Overview"; selected: true; active-in-roving-group: true; index: 0; count: 4; preview-focus-visible: true; }
                AtlasTab { text: "Activity"; index: 1; count: 4; }
                AtlasTab { text: "Settings"; dirty: true; index: 2; count: 4; variant: TabVariant.view; }
                AtlasTab { text: "Disabled"; enabled: false; index: 3; count: 4; }
                Rectangle { horizontal-stretch: 1; background: AtlasTheme.transparent; }
            }
            HorizontalLayout {
                vertical-stretch: 1; spacing: AtlasGrid.space-5;
                Rectangle {
                    horizontal-stretch: 1; border-width: AtlasShape.border-width;
                    border-color: AtlasTheme.border-subtle; border-radius: AtlasShape.radius-surface;
                    background: AtlasTheme.surface;
                    SectionLabel { x: AtlasGrid.space-4; y: AtlasGrid.space-4; text: "CONTEXT MENU"; height: AtlasGrid.space-4; }
                    menu := AtlasMenu {
                        x: AtlasGrid.space-4; y: AtlasGrid.space-10;
                        items: [
                            { id: "open", label: "Open project", shortcut: "Enter", enabled: true, danger: false },
                            { id: "rename", label: "Rename", shortcut: "F2", enabled: true, danger: false },
                            { id: "archive", label: "Archive", shortcut: "", enabled: false, danger: false },
                            { id: "delete", label: "Delete", shortcut: "⌫", enabled: true, danger: true }
                        ];
                        active-index: 1;
                    }
                    SectionLabel { x: AtlasGrid.space-4; y: menu.y + menu.height + AtlasGrid.space-4; text: "TOOLTIP"; height: AtlasGrid.space-4; }
                    AtlasTooltip {
                        x: AtlasGrid.space-12 * 3; y: menu.y + menu.height + AtlasGrid.space-4;
                        text: "Short contextual guidance that is also available to assistive technologies.";
                        tone: TooltipTone.warning; placement: TooltipPlacement.bottom; force-open: true;
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 2;
                    spacing: AtlasGrid.space-4;
                    Rectangle {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        border-width: AtlasShape.border-width;
                        border-color: AtlasTheme.border-subtle; border-radius: AtlasShape.radius-surface;
                        background: AtlasTheme.surface;
                        AtlasModal {
                            x: AtlasGrid.space-3; y: AtlasGrid.space-3;
                            width: parent.width - AtlasGrid.space-6; height: parent.height - AtlasGrid.space-6;
                            open: true; contained: true; size: ModalSize.small;
                            title: "Standard modal"; meta: "HIGH-LEVEL BODY";
