                }
                selection-grid := AtlasAutoGrid {
                    height: root.width < AtlasGrid.breakpoint-compact
                        ? AtlasGrid.space-12 * 8 : AtlasGrid.space-12 * 4;
                    reference-width: root.width >= AtlasGrid.breakpoint-wide
                        ? AtlasGrid.breakpoint-wide - AtlasGrid.space-1 : root.width;
                    gap: LayoutGap.normal;
                    AtlasSelectableText {
                        flex-basis: selection-grid.item-basis; flex-grow: 1;
                        text: "Atlas selects 🙂 Unicode text safely, including واجهة and 品質, without slicing UTF-8 bytes.";
                        selected-text: "Unicode text safely";
                        selection-start: 16; selection-end: 35;
                        selection-byte-start: 19; selection-byte-end: 38;
                        selection-supported: true;
                    }
                    AtlasSelectableText {
                        flex-basis: selection-grid.item-basis; flex-grow: 1;
                        text: "When native rich selection is unavailable, Atlas preserves the source and offers only the explicit Copy all action.";
                        selected-text: "";
                        selection-supported: false;
                    }
                }
                AtlasCallout {
                    height: root.width < AtlasGrid.breakpoint-compact
                        ? AtlasGrid.space-12 * 2 + AtlasGrid.space-6
                        : AtlasGrid.space-12 * 2;
                    compact: true;
                    tone: AdmonitionTone.caution;
                    title: "Clipboard boundary";
                    body: "Components emit text after user intent. Only the host-provided ClipboardPort writes it; failure remains explicit and non-destructive.";
                }
            }
        }
    }
    if root.preview-page == "layout-intrinsics": Rectangle {
        x: frame.content-x; y: AtlasGrid.space-8;
        width: frame.content-width; height: parent.height - AtlasGrid.space-12;
        background: AtlasTheme.canvas;
        VerticalLayout {
            spacing: AtlasGrid.space-4;
            AtlasStickyRegion {
                height: AtlasGrid.space-12 + AtlasGrid.space-2;
                edge: StickyEdge.top;
                elevated: true;
                HorizontalLayout {
                    padding-left: AtlasGrid.space-4; padding-right: AtlasGrid.space-4;
                    padding-top: AtlasGrid.space-2; padding-bottom: AtlasGrid.space-2;
                    spacing: AtlasGrid.space-3;
                    AtlasHeading { horizontal-stretch: 1; text: "Layout workspace"; level: HeadingLevel.h3; }
                    AtlasBadge { text: root.width < AtlasGrid.breakpoint-compact ? "STACKED" : "SPLIT"; tone: BadgeTone.info; }
                }
            }
            split := AtlasSplitView {
                vertical-stretch: 1;
                reference-width: root.width;
                orientation: SplitOrientation.horizontal;
                gap: LayoutGap.none;
                AtlasSplitPane {
                    orientation: SplitOrientation.horizontal;
                    preferred-extent: AtlasGrid.column-min-width * 4;
                    min-extent: split.stacked
                        ? AtlasGrid.space-12 * 4 + AtlasGrid.space-4
                        : AtlasGrid.column-min-width * 2;
                    max-extent: AtlasGrid.content-narrow;
                    flexible: split.stacked;
                    Rectangle {
                        background: AtlasTheme.surface;
                        border-width: AtlasShape.border-width; border-color: AtlasTheme.border-subtle;
                        border-radius: AtlasShape.radius-control;
                        VerticalLayout {
                            padding: AtlasGrid.space-4; spacing: AtlasGrid.space-3;
                            SectionLabel { text: "PRIMARY PANE · 128—640"; }
                            AtlasParagraph { text: "Navigation and filters keep an explicit intrinsic contract."; muted: true; }
                            AtlasTextField { label: "Filter"; value: "layout"; }
                            AtlasButton { text: "Apply constraints"; tone: ButtonTone.secondary; }
                            Rectangle { height: AtlasGrid.space-2; background: AtlasTheme.transparent; }
                        }
                    }
                }
                AtlasResizeHandle {
                    flex-basis: AtlasGrid.space-3; flex-grow: 0; flex-shrink: 0;
                    visible: !split.stacked;
                    orientation: SplitOrientation.horizontal;
                    current-extent: AtlasGrid.column-min-width * 4;
                    min-extent: AtlasGrid.column-min-width * 2;
                    max-extent: AtlasGrid.content-narrow;
                    preview-focus: true;
                }
                AtlasSplitPane {
                    orientation: SplitOrientation.horizontal;
                    preferred-extent: AtlasGrid.content-standard;
                    min-extent: AtlasGrid.column-min-width * 3;
                    max-extent: AtlasGrid.content-wide;
                    flexible: true;
                    Rectangle {
                        background: AtlasTheme.surface-raised;
                        border-width: AtlasShape.border-width; border-color: AtlasTheme.border-subtle;
                        border-radius: AtlasShape.radius-control;
                        VerticalLayout {
                            padding: AtlasGrid.space-4; spacing: AtlasGrid.space-3;
                            SectionLabel { text: "FLEXIBLE CONTENT"; }
                            AtlasIntrinsicFrame {
                                height: AtlasGrid.space-12 * 2;
                                available-width: parent.width;
                                min-content-width: AtlasGrid.column-min-width * 2;
                                max-content-width: AtlasGrid.content-standard;
                                AtlasParagraph {
                                    width: parent.width; height: parent.height;
                                    text: "release/2026-08/atlas_intrinsic_layout_contract_without_break_opportunities_9f6c2a8e";
                                }
                            }
                            AtlasInlineAlert {
                                height: AtlasGrid.space-12 * 2;
                                title: "No local magic numbers";
                                message: "Min, max, resize step and responsive collapse all derive from shared geometry tokens.";
                                tone: AlertTone.info;
                            }
                        }
                    }
                }
            }
            AtlasStickyRegion {
                height: AtlasGrid.space-12 + AtlasGrid.space-2;
                edge: StickyEdge.bottom;
                elevated: true;
                HorizontalLayout {
                    padding-left: AtlasGrid.space-4; padding-right: AtlasGrid.space-4;
                    padding-top: AtlasGrid.space-2; padding-bottom: AtlasGrid.space-2;
                    spacing: AtlasGrid.space-3;
                    AtlasParagraph { horizontal-stretch: 1; text: "Controlled resize · keyboard 16 px · reset with Enter"; muted: true; }
                    AtlasButton { text: "Save layout"; tone: ButtonTone.primary; }
                }
            }
        }
    }
    if root.preview-page == "settings-template": Rectangle {
        x: frame.content-x; y: AtlasGrid.space-8;
        width: frame.content-width; height: parent.height - AtlasGrid.space-12;
        background: AtlasTheme.canvas;
        AtlasSettingsTemplate {
            width: parent.width; height: parent.height;
            reference-width: root.width;
            title: "Workspace settings";
            summary: "A controlled, responsive settings composition built only from shared Atlas fields and actions.";
            active-section-id: "appearance"; dirty: true;
            sections: [
                { id: "profile", label: "Profile", description: "Identity and account", disabled: false },
                { id: "appearance", label: "Appearance", description: "Theme and density", disabled: false },
                { id: "notifications", label: "Notifications", description: "Notice preferences", disabled: false },
                { id: "advanced", label: "Advanced", description: "Restricted configuration", disabled: true },
            ];
            VerticalLayout {
                padding: AtlasGrid.space-5; spacing: AtlasGrid.space-4;
                AtlasSelectField { label: "Theme"; value: "System"; hint: "Follow the platform appearance."; }
                AtlasSwitch { label: "Compact density"; inactive-label: "Normal density"; checked: false; }
                AtlasCheckbox { label: "Reduce motion"; description: "Disable non-essential transitions."; checked: true; }
            }
        }
    }
    if root.preview-page == "dashboard-template": Rectangle {
        x: frame.content-x; y: AtlasGrid.space-8;
        width: frame.content-width; height: parent.height - AtlasGrid.space-12;
        background: AtlasTheme.canvas;
        AtlasDashboardTemplate {
            width: parent.width; height: parent.height;
            reference-width: root.width;
            title: "Delivery overview";
            summary: "Metrics, activity and product-specific content share one predictable responsive skeleton.";
            updated-label: "Updated from deterministic fixture · no remote action";
            metrics: [
                { id: "coverage", label: "Coverage", value: "94%", meta: "+3% this cycle", tone: ValueTone.positive },
                { id: "risks", label: "Open risks", value: "7", meta: "2 require review", tone: ValueTone.negative },
                { id: "components", label: "Components", value: "31", meta: "legacy migration complete", tone: ValueTone.accent },
            ];
            activity: [
                { id: "release", title: "Release candidate validated", detail: "Quality gate and visual scenarios passed.", time: "09:42" },
                { id: "review", title: "Baseline review requested", detail: "Human approval remains pending.", time: "08:15" },
                { id: "tokens", title: "Token audit completed", detail: "No visual literals outside foundations.", time: "Yesterday" },
            ];
            AtlasInlineAlert {
                width: parent.width - AtlasGrid.space-3; height: AtlasGrid.space-12 * 2;
                title: "Preview API";
                message: "Platform validation remains required before stabilization.";
                tone: AlertTone.info;
            }
        }
    }
    if root.preview-page == "documentation-shell"
            || root.preview-page == "documentation-keyboard"
            || root.preview-page == "documentation-scroll-sync"
            || root.preview-page == "documentation-viewport": AtlasDocumentationShell {
        product-name: root.preview-page == "documentation-keyboard"
            ? "Atlas UI · Keyboard paths"
            : root.preview-page == "documentation-scroll-sync"
                ? "Atlas UI · Scroll synchronization"
                : root.preview-page == "documentation-viewport"
                    ? "Atlas UI · Document viewport"
                : "Atlas UI";
        route-id: "responsive";
        active-section-id: root.preview-page == "documentation-scroll-sync"
            ? (root.width >= AtlasGrid.breakpoint-wide ? "accessibility" : "recipes")
            : "recipes";
        navigation-open: root.width < AtlasGrid.breakpoint-compact;
        toc-open: root.preview-page == "documentation-keyboard"
            && root.width >= AtlasGrid.breakpoint-compact
            && root.width < AtlasGrid.breakpoint-wide;
        preview-skip-focus: root.preview-page == "documentation-keyboard"
            && root.width >= AtlasGrid.breakpoint-wide;
        preview-content-focus: (root.preview-page == "documentation-scroll-sync"
                || root.preview-page == "documentation-viewport")
            && root.width < AtlasGrid.breakpoint-wide;
        content-height: root.preview-page == "documentation-viewport"
            ? root.height + AtlasGrid.space-12 * 8
            : AtlasGrid.zero;
        content-scroll-y: root.preview-page == "documentation-viewport"
            ? AtlasGrid.space-12 * 4
            : AtlasGrid.zero;
        preview-scrollbar-active: root.preview-page == "documentation-viewport";
        preview-back-to-top-focus: root.preview-page == "documentation-keyboard"
            && root.width >= AtlasGrid.breakpoint-wide;
        preview-navigation-focus-id: root.preview-page == "documentation-keyboard" ? "responsive" : "";
        preview-toc-focus-id: root.preview-page == "documentation-keyboard" ? "recipes" : "";
        navigation-items: [
            { id: "foundations", label: "Foundations", depth: 0, expanded: true, has-children: true, disabled: false },
            { id: "tokens", label: "Design tokens", depth: 1, expanded: false, has-children: false, disabled: false },
            { id: "components", label: "Components", depth: 0, expanded: true, has-children: true, disabled: false },
            { id: "responsive", label: "Responsive composition", depth: 1, expanded: false, has-children: false, disabled: false },
            { id: "future", label: "Future API", depth: 1, expanded: false, has-children: false, disabled: true }
        ];
        breadcrumbs: [
            { id: "home", label: "Documentation" },
            { id: "components", label: "Components" },
            { id: "responsive", label: "Responsive composition" }
        ];
        toc-items: [
            { id: "overview", label: "Overview", depth: 0 },
            { id: "recipes", label: "Layout recipes", depth: 0 },
            { id: "accessibility", label: "Accessibility", depth: 0 },
            { id: "api", label: "API reference", depth: 0 }
        ];
        footer-links: [
            { id: "license", label: "License" },
            { id: "github", label: "GitHub" }
        ];
        previous-id: "editorial"; previous-label: "Editorial";
        next-id: "rich-content"; next-label: "Rich content";
        show-back-to-top: root.width >= AtlasGrid.breakpoint-wide;
        Rectangle {
            background: AtlasTheme.transparent;
            VerticalLayout {
                spacing: root.width < AtlasGrid.breakpoint-compact
                    ? AtlasGrid.space-3
                    : AtlasGrid.space-4;
                AtlasBadge {
                    text: root.preview-page == "documentation-scroll-sync"
                        ? (root.width >= AtlasGrid.breakpoint-wide
                            ? "USER SCROLL · REPLACE ANCHOR"
                            : "RESTORE · NO HISTORY PUSH")
                        : root.preview-page == "documentation-viewport"
                            ? "FIXED HEADER · INDEPENDENT SCROLL"
                        : "PREVIEW";
                    tone: BadgeTone.info;
                }
                AtlasHeading {
                    height: root.width < AtlasGrid.breakpoint-compact
                        ? AtlasTypography.line-display * 2
                        : AtlasTypography.line-display;
                    text: "Responsive composition"; level: HeadingLevel.h1; anchor-id: "overview";
                }
                if root.preview-page == "documentation-keyboard": AtlasAnchorAction {
                    height: AtlasGrid.space-10;
                    width: AtlasGrid.space-12;
                    anchor-id: "overview";
                    label: "Copy overview deep link";
                    revealed: true;
                    preview-focus-visible: root.width >= AtlasGrid.breakpoint-wide;
                }
                AtlasParagraph {
                    height: root.width < AtlasGrid.breakpoint-compact
                        ? AtlasTypography.line-lead * 4
                        : AtlasTypography.line-lead * 2;
                    text: "Build native documentation interfaces from shared layout recipes, semantic content blocks and controlled navigation contracts.";
                    lead: true; muted: true;
                }
                AtlasAdmonition {
                    height: root.width < AtlasGrid.breakpoint-compact
                        ? AtlasGrid.space-12 * 3
                        : AtlasGrid.space-12 * 2;
                    compact: root.width >= AtlasGrid.breakpoint-compact;
                    title: "Stable application boundary";
                    body: "The shell emits navigation and scroll intentions. Rust remains responsible for routes, history and persistence.";
                }
                AtlasHeading { height: AtlasTypography.line-heading; text: "Layout recipes"; level: HeadingLevel.h2; anchor-id: "recipes"; }
                AtlasDocumentTable {
                    height: AtlasGrid.space-10 * 4;
                    columns: [
                        { title: "Recipe", width: AtlasGrid.column-min-width * 3 },
                        { title: "Purpose", width: AtlasGrid.column-min-width * 5 }
                    ];
                    rows: [
                        { cells: ["AtlasStack", "Vertical rhythm"] },
                        { cells: ["AtlasSidebar", "Intrinsic side content"] },
                        { cells: ["AtlasSwitcher", "Controlled stacking"] }
                    ];
                }
            }
        }
    }
    if root.preview-page == "document-tools": Rectangle {
        background: AtlasTheme.canvas;
        Rectangle {
            x: frame.content-x; y: AtlasGrid.space-8;
            width: frame.content-width; height: parent.height - AtlasGrid.space-12;
            background: AtlasTheme.transparent;
            VerticalLayout {
                spacing: AtlasGrid.space-5;
                AtlasHeading { height: AtlasTypography.line-display; text: "Find anything"; level: HeadingLevel.h1; }
                AtlasParagraph { height: AtlasTypography.line-body * 2; text: "Deterministic full-text results and controlled commands supplied by the Rust document layer."; muted: true; }
                AtlasDocumentSearch {
                    height: AtlasGrid.space-12 * 8;
                    query: "responsive grid";
                    results: [
                        { id: "r1", route: "/components/responsive#auto-grid", title: "Responsive composition", section: "Auto grid", excerpt: "Build intrinsic grids with shared breakpoints and tokenized gaps." },
                        { id: "r2", route: "/foundations/grid", title: "Layout grid", section: "Geometry", excerpt: "Use the four-pixel base grid for predictable native layouts." }
                    ];
                }
                AtlasAnchorAction { width: AtlasGrid.space-12; anchor-id: "auto-grid"; label: "Copy Auto grid deep link"; revealed: true; }
            }
        }
        AtlasCommandPalette {
            open: root.width >= AtlasGrid.breakpoint-compact;
            query: "theme";
            active-index: 0;
            commands: [
                { id: "theme-dark", label: "Use dark theme", group: "Appearance", shortcut: "Enter", disabled: false },
                { id: "theme-light", label: "Use light theme", group: "Appearance", shortcut: "", disabled: false },
                { id: "open-api", label: "Open API reference", group: "Navigation", shortcut: "", disabled: false },
                { id: "future", label: "Future command", group: "Preview", shortcut: "", disabled: true }
            ];
        }
    }
    if root.preview-page == "web-proof": AtlasDocumentationShell {
        product-name: "Atlas UI Reference";
        route-id: "quality-roadmap";
        active-section-id: "status";
        navigation-items: [
            { id: "overview", label: "Overview", depth: 0, expanded: false, has-children: false, disabled: false },
            { id: "governance", label: "Governance", depth: 0, expanded: true, has-children: true, disabled: false },
            { id: "quality-roadmap", label: "Quality roadmap", depth: 1, expanded: false, has-children: false, disabled: false },
            { id: "releases", label: "Release policy", depth: 1, expanded: false, has-children: false, disabled: false },
            { id: "reference", label: "API reference", depth: 0, expanded: false, has-children: false, disabled: false }
        ];
        breadcrumbs: [
            { id: "home", label: "Documentation" },
            { id: "governance", label: "Governance" },
            { id: "quality-roadmap", label: "Quality roadmap" }
        ];
        toc-items: [
            { id: "overview", label: "Overview", depth: 0 },
            { id: "status", label: "Current status", depth: 0 },
            { id: "roadmap", label: "Delivery roadmap", depth: 0 },
            { id: "verification", label: "Verification", depth: 0 }
        ];
        footer-links: [
            { id: "license", label: "License" },
            { id: "compatibility", label: "Compatibility" }
        ];
        previous-id: "governance"; previous-label: "Governance";
        next-id: "releases"; next-label: "Release policy";
        show-back-to-top: root.width >= AtlasGrid.breakpoint-wide;
        AtlasRoadmapContentTemplate {
            reference-width: root.width;
            eyebrow: "QUALITY PROGRAM";
            title: "Native UI quality and release roadmap";
            summary: "A reusable documentation template that turns technical status, delivery phases and verification evidence into a responsive native document.";
            notice-title: "Preview contract";
            notice-body: "Platform evidence and human-reviewed baselines remain required before the public API can move from preview to stable.";
            status-rows: [
                { label: "Design system", owner: "UI platform", status: "Healthy", detail: "Semantic tokens and shared recipes", tone: RoadmapStatusTone.positive },
                { label: "Accessibility", owner: "Quality", status: "In progress", detail: "Desktop screen-reader matrix pending", tone: RoadmapStatusTone.warning },
                { label: "Compatibility", owner: "Runtime", status: "Monitored", detail: "Slint 1.17.1 exact pin", tone: RoadmapStatusTone.neutral },
                { label: "Visual proof", owner: "Release", status: "Review", detail: "Human baseline approval required", tone: RoadmapStatusTone.warning }
            ];
            status-table-rows: [
                { cells: ["Design system", "UI platform", "Healthy", "Semantic tokens and shared recipes"] },
                { cells: ["Accessibility", "Quality", "In progress", "Desktop screen-reader matrix pending"] },
                { cells: ["Compatibility", "Runtime", "Monitored", "Slint 1.17.1 exact pin"] },
                { cells: ["Visual proof", "Release", "Review", "Human baseline approval required"] }
            ];
            phases: [
                { label: "Foundations", description: "Tokens, geometry and interaction complete" },
                { label: "Components", description: "Shared catalogue and content complete" },
                { label: "Documentation", description: "Shell, Markdown and search complete" },
                { label: "Platform proof", description: "Current validation phase" },
                { label: "Stable API", description: "Requires all release gates" }
            ];
            current-phase: 3;
            audit-command: "sh scripts/quality-gate.sh";
            audit-output: "format · check · clippy · tests\nAPI · contrast · assets · visual identities\nstatus: passing";
        }
    }
    if root.preview-page == "content-stress": Rectangle {
        background: AtlasTheme.canvas;
        Rectangle {
            x: frame.content-x; y: AtlasGrid.space-6;
            width: frame.content-width; height: parent.height - AtlasGrid.space-12;
            background: AtlasTheme.transparent;
            clip: true;
            ScrollView {
                viewport-width: parent.width;
                VerticalLayout {
                    width: parent.width; spacing: AtlasGrid.space-5;
                    AtlasHeading {
                        height: AtlasTypography.line-display * 2;
                        text: "Internationalized content resilience";
                        level: HeadingLevel.h1;
                        anchor-id: "health-status";
                    }
                    AtlasParagraph {
                        height: root.width < AtlasGrid.breakpoint-compact ? AtlasTypography.line-body * 5 : AtlasTypography.line-body * 4;
                        text: "This deliberately long sentence verifies that more expansive translations remain readable without changing fundamental component dimensions or hiding essential actions.";
                        lead: true;
                    }
                    AtlasAdmonition {
                        height: root.width < AtlasGrid.breakpoint-compact ? AtlasGrid.space-12 * 3 : AtlasGrid.space-12 * 2;
                        compact: root.width < AtlasGrid.breakpoint-compact;
                        title: "ملاحظة حول إمكانية الوصول";
                        body: "يجب أن تبقى الواجهة قابلة للقراءة عند استخدام نصوص طويلة ومتعددة اللغات.\n品質保証の内容も同じレイアウト契約を使用します。";
                    }
                    AtlasHeading {
                        height: root.width < AtlasGrid.breakpoint-compact
                            ? AtlasTypography.line-heading * 2
                            : AtlasTypography.line-heading;
                        text: "Identifiers and truncation";
                        level: HeadingLevel.h2;
                    }
                    AtlasInlineCode {
                        width: parent.width;
                        height: AtlasGrid.space-8;
                        code: "atlas_component_identifier_without_break_opportunities_0123456789_abcdefghijklmnopqrstuvwxyz";
                    }
                    AtlasDocumentTable {
                        height: root.width < AtlasGrid.breakpoint-compact ? AtlasGrid.space-12 * 11 : AtlasGrid.space-10 * 4;
                        compact: root.width < AtlasGrid.breakpoint-compact;
                        accessible-name: "Localized status table";
                        columns: [
                            { title: "Language", width: AtlasGrid.column-min-width * 2 },
                            { title: "Translated status", width: AtlasGrid.column-min-width * 3 },
                            { title: "Description", width: AtlasGrid.column-min-width * 6 }
                        ];
                        rows: [
                            { cells: ["English", "Validation in progress", "Expanded string that simulates a substantially longer translation"] },
                            { cells: ["العربية", "قيد التحقق", "واجهة موثوقة وقابلة للوصول"] },
                            { cells: ["日本語", "検証中", "長い文章でも予測可能なレイアウト"] }
                        ];
                    }
                    AtlasHeading { height: AtlasTypography.line-heading; text: "Document states"; level: HeadingLevel.h2; }
                    AtlasSwitcher {
                        height: root.width < AtlasGrid.breakpoint-compact ? AtlasGrid.space-12 * 9 : AtlasGrid.space-12 * 3;
                        reference-width: root.width; gap: LayoutGap.compact;
                        AtlasSkeleton { flex-grow: 1; flex-basis: AtlasGrid.column-min-width * 3; lines: 3; }
                        AtlasEmptyState { flex-grow: 1; flex-basis: AtlasGrid.column-min-width * 3; title: "No content"; message: "The requested translation does not contain any sections yet."; }
                        AtlasErrorState { flex-grow: 1; flex-basis: AtlasGrid.column-min-width * 3; title: "Content unavailable"; message: "The localized document could not be prepared."; retry-label: "Try again"; }
                    }
                    Rectangle { height: AtlasGrid.space-12; background: AtlasTheme.transparent; }
                }
            }
        }
    }
    if root.preview-page == "theme-runtime": Rectangle {
        background: AtlasTheme.canvas;
        Rectangle {
            x: frame.content-x; y: AtlasGrid.space-8;
            width: frame.content-width; height: parent.height - AtlasGrid.space-12;
            background: AtlasTheme.transparent;
            VerticalLayout {
                spacing: AtlasGrid.space-6;
                AtlasHeading { height: AtlasTypography.line-display; text: "System theme contract"; level: HeadingLevel.h1; }
                AtlasParagraph {
                    height: AtlasTypography.line-body * 3;
                    text: "The selected preference remains System while the resolved semantic palette follows a live platform appearance signal.";
                    muted: true;
                }
                AtlasThemeControl {
                    width: min(parent.width, AtlasGrid.column-min-width * 7);
                    selected: GalleryThemeMode.system;
                    label: "Persisted appearance preference";
                }
                AtlasPanel {
                    width: min(parent.width, AtlasGrid.content-narrow);
                    height: AtlasGrid.space-12 * 2;
                    title: GallerySettings.resolved-theme-mode == GalleryThemeMode.dark ? "Resolved dark palette" : "Resolved light palette";
                    meta: "preference=system · platform signal applied live";
                    VerticalLayout {
                        padding: AtlasGrid.space-4; spacing: AtlasGrid.space-3;
                        AtlasBadge { text: GallerySettings.system-dark ? "SYSTEM DARK" : "SYSTEM LIGHT"; tone: BadgeTone.info; }
                        AtlasParagraph { height: AtlasTypography.line-body * 2; text: "Semantic canvas, surface, content, border and focus tokens update together."; }
                    }
                }
                AtlasAdmonition {
                    width: min(parent.width, AtlasGrid.content-narrow);
                    height: AtlasGrid.space-12 * 2;
                    compact: true;
                    title: "Persistence boundary";
                    body: "The component emits a preference request. Only the host-provided Rust store may persist it after explicit user intent.";
                }
            }
        }
    }

    LayoutGridOverlay { visible: root.show-grid; }
}
