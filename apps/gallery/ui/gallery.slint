                            { column-id: "custody", text: "COLD, 3 of 5 hardware multisig", accessible-text: "", tooltip: "", editable: false, kind: DataCellKind.stacked-with-badge, primary-text: "", secondary-text: "3 of 5 hardware multisig", badge-text: "COLD", badge-tone: BadgeTone.info, alignment: DataCellAlignment.start, wrap: false },
                            { column-id: "status", text: "Active", accessible-text: "", tooltip: "", editable: false, kind: DataCellKind.badge, badge-text: "ACTIVE", badge-tone: BadgeTone.healthy, alignment: DataCellAlignment.start, wrap: false }
