                        { id: "region", label: "REGION", width: AtlasGrid.column-min-width * 2, min-width: AtlasGrid.column-min-width, max-width: AtlasGrid.column-min-width * 3, grow: 1, resizable: true, sortable: true, filterable: true, editable: false, editor: CellEditorKind.choice, pin: ColumnPin.none },
