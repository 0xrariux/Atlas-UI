                        { id: "staging", selected: false, expanded: true, disabled: false, detail: "Last deployment 8 minutes ago · revision a4f92c1", cells: [{ column-id: "name", text: "Staging", accessible-text: "Staging environment", tooltip: "", editable: true }, { column-id: "region", text: "us-east-1", accessible-text: "US East 1", tooltip: "", editable: false }, { column-id: "status", text: "Deploying", accessible-text: "Deployment in progress", tooltip: "", editable: true }] },
                        { id: "preview", selected: false, expanded: false, disabled: true, detail: "", cells: [{ column-id: "name", text: "Pull request preview with a truncated name", accessible-text: "Pull request preview", tooltip: "Full preview environment name", editable: false }, { column-id: "region", text: "local", accessible-text: "Local", tooltip: "", editable: false }, { column-id: "status", text: "Paused", accessible-text: "Paused", tooltip: "", editable: false }] }
                    ];
                }
                VerticalLayout {
