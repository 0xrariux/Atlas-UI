                    { id: "scope", label: "SCOPE", width: 160px, min-width: 140px, max-width: 1000px, grow: 16, resizable: true, sortable: true, filterable: true, editable: false, editor: CellEditorKind.none, pin: ColumnPin.none },
                    { id: "rights", label: "EFFECTIVE RIGHTS", width: 240px, min-width: 220px, max-width: 1200px, grow: 24, resizable: true, sortable: false, filterable: true, editable: false, editor: CellEditorKind.none, pin: ColumnPin.none },
                    { id: "custody", label: "RECOMMENDED CUSTODY", width: 290px, min-width: 240px, max-width: 1400px, grow: 29, resizable: true, sortable: true, filterable: true, editable: false, editor: CellEditorKind.none, pin: ColumnPin.none },
                    { id: "status", label: "STATUS", width: 120px, min-width: 110px, max-width: 700px, grow: 12, resizable: false, sortable: true, filterable: true, editable: false, editor: CellEditorKind.none, pin: ColumnPin.end }
                ];
                rows: [
