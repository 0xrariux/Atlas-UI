                            { column-id: "status", text: "Guarded", accessible-text: "", tooltip: "", editable: false, kind: DataCellKind.badge, badge-text: "GUARDED", badge-tone: BadgeTone.danger, alignment: DataCellAlignment.start, wrap: false }
